{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "candidate_decision.v1",
 "type": "object",
 "additionalProperties": false,
 "required": ["schema_version", "candidate_id", "candidate_ref", "decision", "decided_at", "revision_id"],
 "properties": {
  "schema_version": {
   "const": "candidate_decision.v1"
  },
  "candidate_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128
  },
  "candidate_ref": {
   "type": "object",
   "additionalProperties": false,
   "required": ["path", "sha256"],
   "properties": {
    "path": {
     "type": "string",
     "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
    },
    "sha256": {
     "type": "string",
     "pattern": "^[a-f0-9]{64}$"
    }
   }
  },
  "decision": {
   "enum": ["keep_current", "reopen"]
  },
  "decided_at": {
   "type": "string",
   "format": "date-time"
  },
  "revision_id": {
   "type": "string",
   "minLength": 1,
   "maxLength": 128
  }
 }
}
