{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ui_draft.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scope": {
          "enum": [
            "project",
            "page"
          ]
        },
        "page_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "layer": {
          "enum": [
            "content",
            "original_image",
            "svg",
            "ppt",
            "prepared_prompt",
            "submitted_prompt",
            "outline",
            "materials",
            "notes"
          ]
        }
      },
      "required": [
        "scope",
        "page_id",
        "layer"
      ]
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "content": {
      "type": "object"
    },
    "pending": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operation_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
            },
            "payload": {
              "type": "object"
            },
            "payload_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "operation_id",
            "payload",
            "payload_digest"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "project_identity",
    "draft_id",
    "target",
    "base_revision",
    "base_ref",
    "content",
    "pending"
  ]
}
