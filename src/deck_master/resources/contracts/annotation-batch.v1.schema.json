{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "annotation_batch.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "annotation_batch.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "annotations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "schema_version": {
            "const": "annotation.v1"
          },
          "annotation_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "project_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "base_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scope": {
            "enum": [
              "project",
              "chapter",
              "page",
              "artifact"
            ]
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "location": {
            "$ref": "shared-contracts.v1.schema.json#/$defs/d_d7891df4d429"
          },
          "chapter_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "content_plan_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "page_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "page_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "layer": {
            "enum": [
              "content",
              "prepared_prompt",
              "submitted_prompt",
              "original_image",
              "svg",
              "ppt"
            ]
          },
          "artifact_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "required": [
          "schema_version",
          "project_id",
          "base_revision",
          "scope",
          "intent",
          "body",
          "status",
          "location"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "chapter"
                }
              }
            },
            "then": {
              "required": [
                "chapter_id",
                "content_plan_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "page"
                }
              }
            },
            "then": {
              "required": [
                "page_id",
                "page_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "scope": {
                  "const": "artifact"
                }
              }
            },
            "then": {
              "required": [
                "page_id",
                "page_ref",
                "layer",
                "artifact_ref"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "location": {
                  "properties": {
                    "kind": {
                      "enum": [
                        "point",
                        "rect",
                        "text"
                      ]
                    }
                  }
                }
              }
            },
            "then": {
              "properties": {
                "scope": {
                  "const": "artifact"
                }
              }
            }
          }
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "annotations"
  ]
}
