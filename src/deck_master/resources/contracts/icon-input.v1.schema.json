{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "icon_input.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "annotation_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "page_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "svg_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "blueprint_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "icons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "semantic_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "original_region": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ]
                },
                "svg_region": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "x": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "y": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "width": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  },
                  "required": [
                    "x",
                    "y",
                    "width",
                    "height"
                  ]
                },
                "objects": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 100,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\d+(?:/\\d+)*$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  }
                },
                "method": {
                  "enum": [
                    "redraw",
                    "standard",
                    "reuse"
                  ]
                },
                "asset_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "sample_candidate_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "sample_icon_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "style": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "color": {
                      "type": "string",
                      "pattern": "^#[a-fA-F0-9]{6}$"
                    },
                    "stroke_width": {
                      "type": "number",
                      "exclusiveMinimum": 0,
                      "maximum": 12
                    }
                  },
                  "required": [
                    "color",
                    "stroke_width"
                  ]
                }
              },
              "required": [
                "label",
                "semantic_key",
                "original_region",
                "svg_region",
                "objects",
                "method",
                "style"
              ]
            }
          }
        },
        "required": [
          "page_id",
          "page_ref",
          "svg_ref",
          "blueprint_ref",
          "icons"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "instruction",
    "annotation_refs",
    "targets"
  ]
}
