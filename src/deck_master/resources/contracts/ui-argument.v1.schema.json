{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_argument.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "ready",
            "partial"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "item": {
              "$ref": "shared-contracts.v1.schema.json#/$defs/d_95ec1bda370c"
            },
            "narrative": {
              "type": "object"
            },
            "related_pages": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "page_id": {
                    "type": "string"
                  },
                  "page_ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  "node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "page_id",
                  "page_ref",
                  "node_ids"
                ]
              }
            },
            "plans": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "$ref": "shared-contracts.v1.schema.json#/$defs/d_c3c006fe1f22"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "path",
                          "sha256"
                        ]
                      },
                      "readable": {
                        "const": true
                      },
                      "data": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "narrative_ref": {
                            "type": "object",
                            "additionalProperties": false,
                            "properties": {
                              "path": {
                                "type": "string",
                                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                              },
                              "sha256": {
                                "type": "string",
                                "pattern": "^[a-f0-9]{64}$"
                              }
                            },
                            "required": [
                              "path",
                              "sha256"
                            ]
                          },
                          "mode": {
                            "type": "string"
                          },
                          "planned_roles": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "role": {
                                  "type": "object"
                                },
                                "page_ref": {
                                  "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
                                },
                                "basis_status": {
                                  "enum": [
                                    "planned",
                                    "current",
                                    "stale",
                                    "not_recorded"
                                  ]
                                }
                              },
                              "required": [
                                "role",
                                "page_ref",
                                "basis_status"
                              ]
                            }
                          },
                          "plan": {
                            "type": "object"
                          }
                        },
                        "required": [
                          "narrative_ref",
                          "mode",
                          "planned_roles",
                          "plan"
                        ]
                      }
                    },
                    "required": [
                      "ref",
                      "readable",
                      "data"
                    ]
                  }
                ]
              }
            },
            "plan_status": {
              "enum": [
                "recorded",
                "absent",
                "partial",
                "unreadable"
              ]
            },
            "decisions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "ref": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  "effective": {
                    "type": "boolean"
                  },
                  "disposition": {
                    "type": "string"
                  },
                  "reason_codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ref",
                  "effective",
                  "disposition",
                  "reason_codes"
                ]
              }
            },
            "adoption": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "readable_in_revision": {
                  "type": "string"
                },
                "assessed_control_revision": {
                  "type": "string"
                },
                "can_record_direction_decision": {
                  "type": "boolean"
                },
                "can_adopt": {
                  "type": "boolean"
                },
                "needs_decision": {
                  "type": "boolean"
                },
                "decision_reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "adoption_reason_codes": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "write_scope": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "existing_decision_ref": {
                  "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
                },
                "subject_ref": {
                  "anyOf": [
                    {
                      "type": "object"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "basis": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "invalidated_refs": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "path",
                          "sha256"
                        ]
                      },
                      "reason": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "ref",
                      "reason"
                    ]
                  }
                }
              },
              "required": [
                "readable_in_revision",
                "assessed_control_revision",
                "can_record_direction_decision",
                "can_adopt",
                "needs_decision",
                "decision_reason_codes",
                "adoption_reason_codes",
                "write_scope",
                "existing_decision_ref",
                "subject_ref",
                "basis",
                "invalidated_refs"
              ]
            }
          },
          "required": [
            "item",
            "narrative",
            "related_pages",
            "plans",
            "plan_status",
            "decisions",
            "adoption"
          ]
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_argument.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "absent",
            "unreadable"
          ]
        },
        "data": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unreadable"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
