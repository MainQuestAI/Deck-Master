{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_review_reading.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "ready",
            "partial"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "review_ref": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            "review": {
              "oneOf": [
                {
                  "$ref": "shared-contracts.v1.schema.json#/$defs/d_c3c006fe1f22"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ref": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      },
                      "required": [
                        "path",
                        "sha256"
                      ]
                    },
                    "readable": {
                      "const": true
                    },
                    "data": {
                      "type": "object"
                    }
                  },
                  "required": [
                    "ref",
                    "readable",
                    "data"
                  ]
                }
              ]
            },
            "targets": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "finding_id": {
                    "type": "string"
                  },
                  "source_index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "page_id": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "page_ref": {
                    "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
                  },
                  "element_refs": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "locator_status": {
                    "enum": [
                      "exact",
                      "page_only",
                      "unavailable"
                    ]
                  },
                  "repair_layer": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "repair_allowed": {
                    "type": "boolean"
                  },
                  "reason_codes": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "finding_id",
                  "source_index",
                  "page_id",
                  "page_ref",
                  "element_refs",
                  "locator_status",
                  "repair_layer",
                  "repair_allowed",
                  "reason_codes"
                ]
              }
            }
          },
          "required": [
            "review_ref",
            "review",
            "targets"
          ]
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_review_reading.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "absent",
            "unreadable"
          ]
        },
        "data": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unreadable"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
