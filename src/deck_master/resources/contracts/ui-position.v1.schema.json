{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ui_position.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "page_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "surface": {
      "enum": [
        "overview",
        "content",
        "gallery",
        "style",
        "runs",
        "page"
      ]
    },
    "layer": {
      "enum": [
        "content",
        "original_image",
        "svg",
        "ppt",
        "prepared_prompt",
        "submitted_prompt"
      ]
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "zoom": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 3
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "project_identity",
    "page_id",
    "surface",
    "layer",
    "revision"
  ]
}
