{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deck-master:text-range:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ref",
    "locator",
    "text_sha256",
    "start",
    "end",
    "excerpt"
  ],
  "properties": {
    "schema_version": {
      "const": "text_range.v1"
    },
    "ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "locator": {
      "type": "string",
      "maxLength": 2000
    },
    "text_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "start": {
      "type": "integer",
      "minimum": 0
    },
    "end": {
      "type": "integer",
      "minimum": 1
    },
    "excerpt": {
      "type": "string",
      "minLength": 1
    }
  }
}
