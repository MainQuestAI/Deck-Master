{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change_intent.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "change_intent.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "targets": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c48b097871b9"
    },
    "intent": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100000
    },
    "annotation_refs": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_3301753341d1"
    },
    "max_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 300
    },
    "mode": {
      "enum": [
        "auto",
        "trial"
      ]
    },
    "references": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_efefe230e1c8"
    },
    "style_recipe_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "style_adopted_candidate_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "icon_recipe_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "targets",
    "intent",
    "instruction",
    "annotation_refs",
    "max_calls"
  ]
}
