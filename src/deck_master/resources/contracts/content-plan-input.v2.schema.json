{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content_plan_input.v2",
  "description": "ContentPlan input v2 (content collaboration v1.2 CONTRACTS §11.2): chapters, stable page order, page roles with narrative/source mapping, budgets, speech policy and local issues.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "chapters",
    "page_order",
    "page_roles",
    "page_budget",
    "time_budget",
    "speech_policy",
    "issues",
    "tradeoff_issue_ids"
  ],
  "properties": {
    "schema_version": {
      "const": "content_plan_input.v2"
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "chapter_id",
          "title",
          "page_ids"
        ],
        "properties": {
          "chapter_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "page_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          }
        }
      }
    },
    "page_order": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "page_roles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "page_id",
          "role",
          "audience_question",
          "intended_takeaway",
          "narrative_node_ids",
          "source_links",
          "required_qualifications",
          "content_profile",
          "density_rationale",
          "timing_seconds",
          "transition_to_next"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "audience_question": {
            "type": "string",
            "minLength": 1
          },
          "intended_takeaway": {
            "type": "string",
            "minLength": 1
          },
          "narrative_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "source_links": {
            "$ref": "shared-contracts.v1.schema.json#/$defs/d_b281d2535872"
          },
          "required_qualifications": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "References to node_id values whose role is qualification in this Plan's bound Narrative; use actual node IDs, not qualification sentences or display labels. Runtime validates identity and node role; semantic support still requires content review. An empty array is valid and asserts no additional referenced qualification. These IDs are non-rendering semantic constraints, not display text; necessary customer-facing conditions must already be authored in customer_visible. Source tracing and author verification do not become display obligations merely because they are recorded here."
          },
          "content_profile": {
            "enum": [
              "simple",
              "evidence",
              "mechanism",
              "data_dense",
              "mixed"
            ],
            "description": "Internal composition classification, not slide copy or evidence grade: simple = one focused message; evidence = support for a claim; mechanism = qualitative operation or relationship; data_dense = genuinely required quantitative detail; mixed = multiple such purposes. It never requires visible source/audit language or a quantitative claim. New roles must declare a value; absent legacy roles remain unknown, not inferred."
          },
          "density_rationale": {
            "type": "string",
            "minLength": 1,
            "description": "Internal explanation of why this page needs its selected information density and which business relationships/conditions must remain. This is design guidance, never text to print, a proof of correctness, or permission to invent/omit customer-visible copy."
          },
          "timing_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "transition_to_next": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "page_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exact",
        "target",
        "max"
      ],
      "properties": {
        "exact": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "target": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "max": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "time_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_seconds",
        "speaking_seconds",
        "interaction_seconds",
        "constraint"
      ],
      "properties": {
        "total_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "speaking_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "interaction_seconds": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "constraint": {
          "enum": [
            "hard",
            "soft",
            "unspecified"
          ]
        }
      }
    },
    "speech_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "source",
        "output"
      ],
      "properties": {
        "mode": {
          "enum": [
            "none",
            "cues",
            "verbatim"
          ]
        },
        "source": {
          "enum": [
            "provided",
            "delegated",
            "default"
          ]
        },
        "output": {
          "enum": [
            "none",
            "separate_script",
            "pptx_notes",
            "both"
          ]
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "question",
          "impact",
          "affected_page_ids",
          "resolution",
          "resolution_ref"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "enum": [
              "blocker",
              "needs_judgment",
              "advisory"
            ]
          },
          "affected_page_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "resolution": {
            "enum": [
              "open",
              "resolved",
              "accepted_limit"
            ]
          },
          "resolution_ref": {
            "anyOf": [
              {
                "$ref": "collaboration.v1.schema.json#/$defs/ref"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "tradeoff_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    }
  }
}
