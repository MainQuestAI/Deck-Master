{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck_review.v1",
  "description": "Deck Master rebuild Spec Pack v1.1 pre-implementation contract clarification; synthetic examples are not production evidence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_review.v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "kind": {
      "enum": [
        "content",
        "blueprint_content",
        "blueprint_fidelity",
        "conversion",
        "readability",
        "privacy",
        "professional_use",
        "desktop_editing"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "needs_review",
        "not_evaluated",
        "not_applicable"
      ]
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "content",
              "source",
              "blueprint",
              "svg",
              "asset",
              "style",
              "toolchain",
              "artifact",
              "policy"
            ]
          },
          "identity": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "identity",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "tool",
            "host_self",
            "independent_host",
            "human_internal",
            "human_external"
          ]
        },
        "id": {
          "type": "string"
        },
        "execution_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "independence_confirmed": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "id",
        "execution_ref",
        "independence_confirmed"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "kind": {
            "enum": [
              "content",
              "design",
              "conversion",
              "readability",
              "source",
              "privacy",
              "artifact",
              "observation"
            ]
          },
          "impact": {
            "enum": [
              "must_fix",
              "needs_judgment",
              "advisory"
            ]
          },
          "page_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "element_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          },
          "expected": {
            "type": "string"
          },
          "actual": {
            "type": "string"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "resolution": {
            "enum": [
              "open",
              "fixed",
              "accepted_variance",
              "not_applicable"
            ]
          },
          "resolution_reason": {
            "type": "string"
          }
        },
        "required": [
          "finding_id",
          "kind",
          "impact",
          "page_id",
          "element_refs",
          "message",
          "expected",
          "actual",
          "evidence",
          "resolution"
        ],
        "additionalProperties": false
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "replaces": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "kind",
    "status",
    "subjects",
    "dependencies",
    "reviewer",
    "observations",
    "findings",
    "created_at",
    "replaces"
  ],
  "additionalProperties": false
}
