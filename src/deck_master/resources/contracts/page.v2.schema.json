{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck_page_package.v2",
  "description": "Deck Master rebuild Spec Pack v1.1 pre-implementation contract clarification; synthetic examples are not production evidence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_page_package.v2"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "customer_visible": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "body_blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "paragraph"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "bullets"
                  },
                  "heading": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/bullet_item"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "table"
                  },
                  "title": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "cells": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "column_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                              },
                              "display_text": {
                                "type": "string"
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "string",
                                  "null"
                                ]
                              },
                              "unit": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "column_id",
                              "display_text"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "id",
                        "cells"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "columns",
                  "rows"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              },
              "tone": {
                "enum": [
                  "neutral",
                  "emphasis"
                ]
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "body_blocks"
      ],
      "additionalProperties": false
    },
    "speaker_notes": {
      "type": "string"
    },
    "visual_spec": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string"
        },
        "layout_hint": {
          "type": "string"
        },
        "reference_mode": {
          "enum": [
            "faithful_reconstruction",
            "new_design"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "label_ref": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "existing",
                  "proposed",
                  "out_of_scope",
                  "unspecified"
                ]
              },
              "responsibility_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "node_id",
              "label_ref",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edge_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "direction": {
                "enum": [
                  "forward",
                  "both",
                  "undirected"
                ]
              },
              "relationship": {
                "type": "string"
              },
              "label_ref": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "edge_id",
              "from",
              "to",
              "direction",
              "relationship"
            ],
            "additionalProperties": false
          }
        },
        "style_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "description": "Document.design_context.styles[].style_id, not a path or mutable external URL."
        },
        "design_overrides": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "body_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "heading_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "allowed_asset_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "uniqueItems": true
            },
            "layout_notes": {
              "type": "string",
              "description": "Replaces project layout notes for this page, including explicit empty clearing."
            },
            "selected_asset_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "description": "Actual image attachments selected for this page; subset of permitted assets. Missing selects none for new preparations."
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "design_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "strategy",
            "purpose",
            "primary_object",
            "free_layout",
            "layout_instruction",
            "table_roles"
          ],
          "properties": {
            "version": {
              "const": "design_policy.v1"
            },
            "strategy": {
              "enum": [
                "agreed_layout",
                "model_designed"
              ]
            },
            "purpose": {
              "type": "string",
              "minLength": 1
            },
            "primary_object": {
              "type": "string",
              "minLength": 1
            },
            "free_layout": {
              "type": "string",
              "minLength": 1
            },
            "layout_instruction": {
              "type": "string"
            },
            "table_roles": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "block_id",
                  "role"
                ],
                "properties": {
                  "block_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "enum": [
                      "comparison",
                      "content_inventory"
                    ]
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "strategy": {
                    "const": "agreed_layout"
                  }
                }
              },
              "then": {
                "properties": {
                  "layout_instruction": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "intent",
        "reference_mode"
      ],
      "additionalProperties": false
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "locator": {
            "type": "string"
          },
          "supports": {
            "type": "string"
          },
          "claim_kind": {
            "enum": [
              "reported_fact",
              "inference",
              "design_proposal",
              "calculation",
              "target"
            ]
          },
          "expression": {
            "type": "string"
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "source_id",
          "locator",
          "supports",
          "claim_kind"
        ],
        "additionalProperties": false
      }
    },
    "internal_only": {
      "type": "object",
      "properties": {
        "production_notes": {
          "type": "string"
        },
        "source_private_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "content_mapping": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "description": "Page content mapping (CONTRACTS §11.3): atom-level links to Narrative nodes/sources and speaker-note speech segments.",
          "additionalProperties": false,
          "required": [
            "narrative_ref",
            "plan_role_page_id",
            "visible_links",
            "speech_segments"
          ],
          "properties": {
            "narrative_ref": {
              "anyOf": [
                {
                  "$ref": "collaboration.v1.schema.json#/$defs/ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "plan_role_page_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "visible_links": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "element_ref",
                  "narrative_node_ids",
                  "source_links"
                ],
                "properties": {
                  "element_ref": {
                    "type": "string",
                    "pattern": "^atom:[A-Za-z0-9_.:-]+$"
                  },
                  "narrative_node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    }
                  },
                  "source_links": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "source_id",
                        "source_version",
                        "locator"
                      ],
                      "properties": {
                        "source_id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "source_version": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "original_sha256",
                            "extract"
                          ],
                          "properties": {
                            "original_sha256": {
                              "anyOf": [
                                {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{64}$"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "extract": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "path",
                                "sha256"
                              ],
                              "properties": {
                                "path": {
                                  "type": "string",
                                  "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                                },
                                "sha256": {
                                  "type": "string",
                                  "pattern": "^[a-f0-9]{64}$"
                                }
                              }
                            }
                          }
                        },
                        "locator": {
                          "type": "string",
                          "minLength": 1,
                          "pattern": "\\S"
                        }
                      }
                    }
                  }
                }
              }
            },
            "speech_segments": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "segment_id",
                  "start_codepoint",
                  "end_codepoint",
                  "narrative_node_ids",
                  "kind",
                  "estimated_seconds"
                ],
                "properties": {
                  "segment_id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "start_codepoint": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "end_codepoint": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "narrative_node_ids": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    }
                  },
                  "kind": {
                    "enum": [
                      "cue",
                      "verbatim"
                    ]
                  },
                  "estimated_seconds": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "page_id",
    "customer_visible",
    "visual_spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "bullet_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet_item"
          }
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
