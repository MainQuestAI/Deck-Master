{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate_adoption.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "candidate_adoption.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "selections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "candidate_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "candidate_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "page_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "stage": {
            "enum": [
              "blueprint",
              "svg"
            ]
          },
          "target_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "result_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "basis_digest": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "downstream": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "candidate_id",
          "candidate_ref",
          "page_id",
          "stage",
          "target_ref",
          "result_ref",
          "basis_digest",
          "downstream"
        ]
      },
      "minItems": 1,
      "maxItems": 300
    },
    "max_calls": {
      "const": 0
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "selections",
    "max_calls"
  ]
}
