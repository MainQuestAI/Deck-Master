{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "generation_request.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "generation_request.v1"
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_id": {
      "type": "string"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "generation_input.v1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "generation_input.v1"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_d61b02986913"
        },
        "design_context": {
          "type": "object"
        },
        "template_ref": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
        },
        "references": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_25a2c6e4baa2"
        },
        "parameters": {
          "type": "object"
        },
        "constraints": {
          "type": "object"
        },
        "basis": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_a3092af0fa7d"
        },
        "style_recipe_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        }
      },
      "required": [
        "schema_version",
        "prompt",
        "page",
        "design_context",
        "template_ref",
        "references",
        "parameters",
        "constraints",
        "basis"
      ]
    },
    "created_at_ms": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "task_id",
    "project_id",
    "operation_id",
    "input_hash",
    "input",
    "created_at_ms"
  ]
}
