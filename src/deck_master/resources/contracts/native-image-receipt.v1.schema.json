{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "native_image_receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "native_image_receipt.v1"
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "adapter_version": {
      "type": "string",
      "minLength": 1
    },
    "assurance": {
      "const": "host_attested"
    },
    "authentication": {
      "const": "protected_transport"
    },
    "raw_event_ref": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "provider_id",
    "adapter_version",
    "assurance",
    "authentication",
    "raw_event_ref",
    "claims"
  ]
}
