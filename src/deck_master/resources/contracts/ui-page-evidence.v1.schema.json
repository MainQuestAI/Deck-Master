{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_page_evidence.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "ready",
            "partial"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "page_id": {
              "type": "string"
            },
            "page_ref": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            "narrative_ref": {
              "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
            },
            "alignment": {
              "enum": [
                "current",
                "bound_to_older_narrative",
                "not_recorded"
              ]
            },
            "elements": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "element_ref": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  },
                  "mapping_status": {
                    "enum": [
                      "recorded",
                      "not_recorded",
                      "unreadable"
                    ]
                  },
                  "nodes": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "edges": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "qualifications": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "direct_source_links": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  },
                  "node_source_links": {
                    "type": "array",
                    "items": {
                      "type": "object"
                    }
                  }
                },
                "required": [
                  "element_ref",
                  "text",
                  "mapping_status",
                  "nodes",
                  "edges",
                  "qualifications",
                  "direct_source_links",
                  "node_source_links"
                ]
              }
            }
          },
          "required": [
            "page_id",
            "page_ref",
            "narrative_ref",
            "alignment",
            "elements"
          ]
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_page_evidence.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "absent",
            "unreadable"
          ]
        },
        "data": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unreadable"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
