{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck-master-handoff.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "deck-master-handoff.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "change_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "queued",
              "awaiting_host",
              "running",
              "completed",
              "failed",
              "cancelled",
              "superseded"
            ]
          },
          "execution_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "operation_id": {
            "type": "string",
            "minLength": 1
          },
          "protocol_version": {
            "type": [
              "string",
              "null"
            ]
          },
          "required_capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "request_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scope_pages": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "result_refs": {
            "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
          },
          "candidate_refs": {
            "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
          },
          "execution_started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "execution_time_source": {
            "enum": [
              "core_recorded",
              "not_recorded"
            ]
          },
          "call_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          },
          "needs_verification": {
            "type": "boolean"
          },
          "attempt_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "task_id",
          "status",
          "execution_ref",
          "operation_id",
          "protocol_version",
          "required_capabilities",
          "request_ids"
        ]
      }
    },
    "plan_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "plan": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "change_plan.v1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "change_plan.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_24b9804cc506"
        },
        "actions": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_fc1b4cb9040a"
        },
        "max_calls": {
          "type": "integer",
          "minimum": 0
        },
        "effects": {
          "type": "string"
        },
        "content_identity": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "base_revision",
        "payload_digest",
        "input",
        "actions",
        "max_calls",
        "effects",
        "content_identity"
      ]
    },
    "read_command": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "change_id",
    "base_revision",
    "tasks",
    "plan_ref",
    "plan",
    "read_command"
  ]
}
