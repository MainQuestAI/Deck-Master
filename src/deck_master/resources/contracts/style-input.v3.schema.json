{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "style_input.v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "style_input.v3"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_page_ids": {
      "type": "array",
      "minItems": 0,
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "typography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "density": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "lines": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        }
      },
      "required": []
    },
    "host_suggestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "resolutions": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "keep_target",
          "use_reference"
        ]
      }
    },
    "parent_recipe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "intent": {
      "enum": [
        "initial_design",
        "restyle",
        "feasibility"
      ]
    },
    "recipe_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "typography",
        "density",
        "composition",
        "spacing",
        "lines",
        "icons"
      ],
      "properties": {
        "palette": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "body_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "heading_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "body_size_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heading_size_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "auxiliary_size_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "body_font_id",
            "heading_font_id",
            "body_size_pt",
            "heading_size_pt",
            "auxiliary_size_pt"
          ],
          "additionalProperties": false
        },
        "density": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "icons": {
          "type": "string",
          "minLength": 1
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "margin_px",
            "gap_px"
          ],
          "properties": {
            "margin_px": {
              "type": "number",
              "minimum": 0
            },
            "gap_px": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        "lines": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width_px",
            "color"
          ],
          "properties": {
            "width_px": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "allowed_page_overrides": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "body_font_id",
              "heading_font_id",
              "language",
              "allowed_asset_ids"
            ]
          }
        }
      }
    },
    "reference_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "revision_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "artifact_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "role": {
            "enum": [
              "reference",
              "edit_target",
              "supporting"
            ]
          }
        },
        "required": [
          "page_id",
          "revision_id",
          "artifact_ref",
          "role"
        ]
      }
    },
    "layout_rationale": {
      "type": "string",
      "minLength": 1
    },
    "uncovered_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "target_page_ids",
    "instruction",
    "intent",
    "recipe_draft",
    "reference_refs"
  ]
}
