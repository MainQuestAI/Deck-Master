{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "style_input.v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "style_input.v3"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": [
        "initial_design",
        "restyle",
        "feasibility"
      ],
      "description": "feasibility uses the registered zero-call design-only action over actual Page/Narrative/Plan inputs; it cannot dispatch sample production."
    },
    "target_page_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "reference_refs": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_d4da8bd1bce1"
    },
    "recipe_draft": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_aac8116b27b4"
    },
    "page_profiles": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_0d0e9f6a17e8"
    },
    "layout_rationale": {
      "type": "string",
      "minLength": 1
    },
    "sample_targets": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_6d467ecec522"
    },
    "uncovered_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "parent_recipe_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "intent",
    "target_page_ids",
    "instruction",
    "reference_refs",
    "recipe_draft",
    "page_profiles",
    "layout_rationale",
    "sample_targets",
    "uncovered_cases",
    "tradeoffs"
  ]
}
