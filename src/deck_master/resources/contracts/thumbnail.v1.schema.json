{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deck-master:thumbnail:v1",
  "type": "object",
  "required": [
    "schema_version",
    "cache_key",
    "project_identity",
    "source_ref",
    "source_signature",
    "variant",
    "width",
    "height",
    "bytes",
    "sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "thumbnail.v1"
    },
    "cache_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "source_signature": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "variant": {
      "const": "thumb-480-png-v1"
    },
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 480
    },
    "bytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000000
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
