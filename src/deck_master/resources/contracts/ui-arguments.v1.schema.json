{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_arguments.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "ref": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "page_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "code",
              "field",
              "message",
              "ref",
              "page_id"
            ]
          }
        },
        "status": {
          "enum": [
            "ready",
            "partial"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "path",
                          "sha256"
                        ]
                      },
                      "readable": {
                        "const": false
                      },
                      "issues": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "additionalProperties": false,
                          "properties": {
                            "code": {
                              "type": "string"
                            },
                            "field": {
                              "type": "string"
                            },
                            "message": {
                              "type": "string"
                            },
                            "ref": {
                              "anyOf": [
                                {
                                  "type": "object",
                                  "additionalProperties": false,
                                  "properties": {
                                    "path": {
                                      "type": "string",
                                      "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                                    },
                                    "sha256": {
                                      "type": "string",
                                      "pattern": "^[a-f0-9]{64}$"
                                    }
                                  },
                                  "required": [
                                    "path",
                                    "sha256"
                                  ]
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "page_id": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "code",
                            "field",
                            "message",
                            "ref",
                            "page_id"
                          ]
                        }
                      }
                    },
                    "required": [
                      "ref",
                      "readable",
                      "issues"
                    ]
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "ref": {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "path": {
                            "type": "string",
                            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                          },
                          "sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                          }
                        },
                        "required": [
                          "path",
                          "sha256"
                        ]
                      },
                      "readable": {
                        "const": true
                      },
                      "narrative_id": {
                        "type": "string"
                      },
                      "maturity": {
                        "enum": [
                          "framing",
                          "argument"
                        ]
                      },
                      "relation": {
                        "enum": [
                          "current",
                          "proposal",
                          "historical"
                        ]
                      },
                      "request_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "producer_task_id": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "communication_question": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "central_statement": {
                        "anyOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      }
                    },
                    "required": [
                      "ref",
                      "readable",
                      "narrative_id",
                      "maturity",
                      "relation",
                      "request_id",
                      "producer_task_id",
                      "communication_question",
                      "central_statement"
                    ]
                  }
                ]
              }
            },
            "pagination": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "next_offset": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "limit",
                "offset",
                "next_offset"
              ]
            }
          },
          "required": [
            "items",
            "pagination"
          ]
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_arguments.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "ref": {
                "anyOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    },
                    "required": [
                      "path",
                      "sha256"
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "page_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "code",
              "field",
              "message",
              "ref",
              "page_id"
            ]
          }
        },
        "status": {
          "enum": [
            "absent",
            "unreadable"
          ]
        },
        "data": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unreadable"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
