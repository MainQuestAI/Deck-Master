{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_arguments.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "ready",
            "partial"
          ]
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "shared-contracts.v1.schema.json#/$defs/d_95ec1bda370c"
              }
            },
            "pagination": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limit": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                "offset": {
                  "type": "integer",
                  "minimum": 0
                },
                "next_offset": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "limit",
                "offset",
                "next_offset"
              ]
            }
          },
          "required": [
            "items",
            "pagination"
          ]
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "ui_arguments.v1"
        },
        "project_id": {
          "type": "string"
        },
        "revision_id": {
          "type": "string"
        },
        "issues": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_7f09caaa780b"
        },
        "status": {
          "enum": [
            "absent",
            "unreadable"
          ]
        },
        "data": {
          "type": "null"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "revision_id",
        "issues",
        "status",
        "data"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "unreadable"
              }
            }
          },
          "then": {
            "properties": {
              "issues": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  ]
}
