{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content_requirements.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "content_requirements.v1"
    },
    "mode": {
      "enum": [
        "fidelity",
        "planned"
      ]
    },
    "page_id": {
      "type": "string",
      "minLength": 1
    },
    "page_role": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "audience_question": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "intended_takeaway": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "transition_to_next": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "role",
            "audience_question",
            "intended_takeaway",
            "transition_to_next"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "content_profile": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Non-rendering composition classification copied from the selected actual Plan role; null means no declared role/profile (legacy or partial import). It is not an evidence grade or an instruction to print provenance."
    },
    "density_rationale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ],
      "description": "Non-rendering design guidance copied from the actual Plan role; null means unavailable. Do not print its prose or turn author/source verification into slide copy."
    },
    "required_qualifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Actual qualification-node identifiers from the bound Narrative, not sentences to print. Empty is valid. Historical stored values remain readable without reinterpretation; new Plan writes validate node identity and role. Business conditions must be present in customer_visible to be rendered."
    },
    "structure_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atom_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "edge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "atom_ids",
        "node_ids",
        "edge_ids"
      ]
    },
    "visual_intent": {
      "type": "string"
    },
    "layout_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "text_visibility": {
      "const": "customer_visible_only.v1",
      "description": "Versioned consumption policy for newly resolved requirements. Only Page.customer_visible supplies rendered text. Requirements, profile, density rationale, roles, node IDs and provenance are non-rendering context. Absent on historical frozen objects means retain their original projection and policy; never inject this field into immutable history."
    }
  },
  "required": [
    "schema_version",
    "mode",
    "page_id",
    "page_role",
    "content_profile",
    "density_rationale",
    "required_qualifications",
    "structure_refs",
    "visual_intent",
    "layout_hint"
  ]
}
