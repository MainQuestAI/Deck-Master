{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content_requirements.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "page_id",
    "page_role",
    "content_profile",
    "density_rationale",
    "required_qualifications",
    "structure_refs",
    "visual_intent",
    "layout_hint"
  ],
  "properties": {
    "schema_version": {
      "const": "content_requirements.v1"
    },
    "mode": {
      "enum": [
        "planned",
        "fidelity"
      ]
    },
    "page_id": {
      "type": "string",
      "minLength": 1
    },
    "page_role": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "role",
            "audience_question",
            "intended_takeaway",
            "transition_to_next"
          ],
          "properties": {
            "role": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "audience_question": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "intended_takeaway": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            },
            "transition_to_next": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "content_profile": {
      "anyOf": [
        {
          "enum": [
            "simple",
            "evidence",
            "mechanism",
            "data_dense",
            "mixed"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "density_rationale": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_qualifications": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "structure_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "atom_ids",
        "node_ids",
        "edge_ids"
      ],
      "properties": {
        "atom_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "node_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "edge_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visual_intent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "layout_hint": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
