{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content-plan.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "content_plan.v1"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "origin": {
      "enum": [
        "host_composed",
        "user_imported",
        "user_edited"
      ]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "input_digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "produced_against": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "revision_id",
        "input_digest",
        "produced_against"
      ]
    },
    "previous_ref": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "content_plan_input.v1"
        },
        "input_summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "chapters": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_161059304e25"
        },
        "goals": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_e8da224e8090"
        },
        "unresolved_facts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "minItems": 0
        }
      },
      "required": [
        "schema_version",
        "input_summary",
        "chapters",
        "goals",
        "unresolved_facts"
      ]
    },
    "page_links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "goal_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "page_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "page_ref": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "required": [
          "goal_id",
          "page_id",
          "page_ref"
        ]
      },
      "minItems": 1
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    }
  },
  "required": [
    "schema_version",
    "plan_id",
    "version",
    "project_id",
    "task_id",
    "origin",
    "basis",
    "previous_ref",
    "input",
    "page_links"
  ]
}
