    {
      "schema_version": "deck_page_package.v2",
      "page_id": "p01",
      "customer_visible": {
        "title": "把设备知识接入服务人员实际使用的入口",
        "body_blocks": [
          {
            "id": "b1",
            "type": "paragraph",
            "text": "澄川科技提供技术资料接入、引用式问答、企业身份与资料权限对接，并将查询能力嵌入已有业务门户。服务人员可以查找相关资料，返回原文核对适用条件。"
          },
          {
            "id": "b2",
            "type": "paragraph",
            "text": "在北澜设备项目中，我们完成了设备手册与维修工单接入、权限对接、引用问答界面及上线培训。这些经验对应资料、访问身份和工作入口的协同建设。"
          },
          {
            "id": "b3",
            "type": "paragraph",
            "text": "本次接入方案可复用资料整合、权限对接和上线培训经验，适配工作按嘉禾的业务条件另行设计。"
          }
        ]
      },
      "speaker_notes": "",
      "visual_spec": {
        "intent": "用资料、权限、服务入口的关系图与实际交付说明呈现能力，避免三个无连接的宣传口号。",
        "reference_mode": "new_design"
      },
      "citations": [
        {
          "id": "c1",
          "source_id": "src-company",
          "locator": "line:3-6",
          "supports": "b1,b2",
          "claim_kind": "reported_fact"
        }
      ],
