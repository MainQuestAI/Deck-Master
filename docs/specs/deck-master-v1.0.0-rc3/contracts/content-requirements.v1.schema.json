{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "content_requirements.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "content_requirements.v1"
    },
    "mode": {
      "enum": [
        "fidelity",
        "planned"
      ]
    },
    "page_id": {
      "type": "string",
      "minLength": 1
    },
    "page_role": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "audience_question": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "intended_takeaway": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "transition_to_next": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "role",
            "audience_question",
            "intended_takeaway",
            "transition_to_next"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "content_profile": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "density_rationale": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "required_qualifications": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "structure_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "atom_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "edge_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "atom_ids",
        "node_ids",
        "edge_ids"
      ]
    },
    "visual_intent": {
      "type": "string"
    },
    "layout_hint": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "schema_version",
    "mode",
    "page_id",
    "page_role",
    "content_profile",
    "density_rationale",
    "required_qualifications",
    "structure_refs",
    "visual_intent",
    "layout_hint"
  ]
}
