            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "blueprint_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "type": "object"
          }
        },
        "required": [
          "page_id",
          "page_ref",
          "blueprint_ref",
          "content"
        ]
      }
    },
    "reference_sources": {
      "type": "object"
    },
    "preserve_dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "propertyNames": {
        "enum": [
          "palette",
          "typography",
          "density",
          "lines",
          "composition"
        ]
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "palette": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "typography": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "density": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "lines": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "composition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "spacing": {
          "type": "string",
          "minLength": 1
        },
        "icons": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
