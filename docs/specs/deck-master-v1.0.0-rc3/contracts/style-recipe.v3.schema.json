          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "intent": {
      "enum": [
        "initial_design",
        "restyle",
        "feasibility"
      ]
    },
    "recipe_draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "palette",
        "typography",
        "density",
        "composition",
        "spacing",
        "lines",
        "icons"
      ],
      "properties": {
        "palette": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          }
        },
        "typography": {
          "type": "object",
          "properties": {
            "body_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "heading_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "body_size_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "heading_size_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "auxiliary_size_pt": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "body_font_id",
            "heading_font_id",
            "body_size_pt",
            "heading_size_pt",
            "auxiliary_size_pt"
          ],
          "additionalProperties": false
        },
        "density": {
          "type": "string",
          "minLength": 1
        },
        "composition": {
          "type": "string",
          "minLength": 1
        },
        "icons": {
          "type": "string",
          "minLength": 1
        },
        "spacing": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "margin_px",
            "gap_px"
          ],
          "properties": {
            "margin_px": {
              "type": "number",
