    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preserve_target_content": {
      "const": true
    },
    "suggestion_state": {
      "enum": [
        "none",
        "unconfirmed",
        "confirmed"
      ]
