{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "style_recipe.v3",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "style_recipe.v3"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "input": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_38c39ac79c42"
    },
    "intent": {
      "enum": [
        "initial_design",
        "restyle",
        "feasibility"
      ]
    },
    "basis": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_741ce084befe"
    },
    "targets": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_66628de244da"
    },
    "reference_refs": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_d4da8bd1bce1"
    },
    "recipe_draft": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_aac8116b27b4"
    },
    "parent_recipe_ref": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
    },
    "page_profiles": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_0d0e9f6a17e8"
    },
    "layout_rationale": {
      "type": "string",
      "minLength": 1
    },
    "sample_targets": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_6d467ecec522"
    },
    "uncovered_cases": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "dimensions": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_7e0e1e286b7d"
    },
    "preserve_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {},
      "required": []
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "maxItems": 0
    },
    "diff": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_a8b177ff4a49"
    },
    "preserve_target_content": {
      "const": true
    },
    "suggestion_state": {
      "const": "none"
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "proposal_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "layers": {
          "const": [
            "design"
          ]
        }
      },
      "required": [
        "page_ids",
        "layers"
      ]
    },
    "parameters": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_aac8116b27b4"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "input",
    "intent",
    "basis",
    "targets",
    "reference_refs",
    "recipe_draft",
    "parent_recipe_ref",
    "page_profiles",
    "layout_rationale",
    "sample_targets",
    "uncovered_cases",
    "tradeoffs",
    "dimensions",
    "preserve_dimensions",
    "conflicts",
    "diff",
    "preserve_target_content",
    "suggestion_state",
    "recipe_id",
    "version",
    "proposal_ref",
    "scope",
    "parameters"
  ]
}
