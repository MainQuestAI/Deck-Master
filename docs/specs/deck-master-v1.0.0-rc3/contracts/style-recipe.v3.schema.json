    "page_profiles": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "layout_rationale": {
      "type": "string"
    },
    "sample_targets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "uncovered_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tradeoffs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "input",
    "targets",
    "reference_sources",
    "dimensions",
    "conflicts",
    "diff",
    "preserve_target_content",
    "suggestion_state",
    "recipe_id",
    "version",
    "parent_ref",
    "proposal_ref",
    "intent",
    "recipe_draft",
    "page_profiles",
    "layout_rationale",
    "sample_targets",
    "uncovered_cases",
    "tradeoffs"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "intent": {
            "const": "feasibility"
          }
        }
      },
      "then": {},
      "else": {
        "properties": {
          "targets": {
            "minItems": 1
          }
        }
      }
    }
  ]
