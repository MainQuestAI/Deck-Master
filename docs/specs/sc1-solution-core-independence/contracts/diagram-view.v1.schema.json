{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deck-master:sc1:deck_diagram_view.v1",
  "title": "deck_diagram_view.v1",
  "description": "SC-1 target contract draft; not installed in the current repository. Structural validation is not runtime or semantic verification.",
  "x-spec-status": "target-draft",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_diagram_view.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "production",
        "benchmark",
        "fixture",
        "dev"
      ]
    },
    "based_on": {
      "type": "object",
      "properties": {
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ref",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "input_fingerprint",
        "input_refs"
      ],
      "additionalProperties": false
    },
    "view_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "view_type": {
      "type": "string",
      "enum": [
        "business_architecture",
        "application_architecture",
        "data_flow",
        "implementation_roadmap"
      ]
    },
    "model_ref": {
      "type": "string",
      "minLength": 1
    },
    "model_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "scope_note": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "model_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
            },
            "minItems": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "aggregation_reason": {
            "type": "string",
            "minLength": 0
          }
        },
        "required": [
          "id",
          "model_refs",
          "label",
          "aggregation_reason"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "from_node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "to_node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "relation_ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "from_node_id",
          "to_node_id",
          "relation_ref",
          "label"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "layout": {
      "type": "object",
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "layered",
            "left_to_right",
            "top_to_bottom",
            "timeline",
            "matrix"
          ]
        },
        "aspect_ratio": {
          "const": "16:9"
        },
        "editability_target": {
          "const": "native_shapes"
        }
      },
      "required": [
        "strategy",
        "aspect_ratio",
        "editability_target"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "run_mode",
    "based_on",
    "view_id",
    "page_id",
    "view_type",
    "model_ref",
    "model_sha256",
    "title",
    "scope_note",
    "nodes",
    "edges",
    "layout"
  ],
  "additionalProperties": false
}
