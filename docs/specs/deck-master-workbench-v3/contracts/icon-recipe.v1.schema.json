{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "icon_proposal.v1",
        "icon_recipe.v1"
      ]
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "icon_input.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "annotation_refs": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_3301753341d1"
        },
        "targets": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_f60569ca537a"
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "base_revision",
        "instruction",
        "annotation_refs",
        "targets"
      ]
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "proposal_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "catalog_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "input",
    "catalog_digest"
  ]
}
