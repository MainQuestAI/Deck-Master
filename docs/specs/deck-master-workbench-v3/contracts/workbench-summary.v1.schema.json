{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deck-master:workbench-summary:v1",
  "title": "workbench_summary.v1 read projection (not a persistent object)",
  "type": "object",
  "required": ["format", "project_id", "revision_id", "requested_revision", "snapshot_mode", "page_count", "pages", "task_counts", "unreadable_tasks", "outputs", "input_alignment", "quality", "candidates", "attempts", "evidence_level"],
  "additionalProperties": false,
  "properties": {
    "format": {"const": "workbench_summary.v1"},
    "project_id": {"type": "string"},
    "revision_id": {"type": "string"},
    "requested_revision": {"type": ["string", "null"]},
    "snapshot_mode": {"enum": ["current", "fixed"]},
    "page_count": {"type": "integer", "minimum": 0},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/page_summary"}},
    "task_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "unreadable_tasks": {"type": "integer", "minimum": 0},
    "outputs": {"type": "object", "required": ["pptx"], "additionalProperties": false, "properties": {"pptx": {"$ref": "#/$defs/deck_output"}}},
    "input_alignment": {"enum": ["no_content", "legacy_current", "current", "needs_reconciliation"]},
    "quality": {"type": "object", "required": ["status", "review_refs"], "properties": {"status": {"const": "detail_required"}, "review_refs": {"type": "array", "items": {"$ref": "#/$defs/ref"}}}, "additionalProperties": false},
    "candidates": {"$ref": "#/$defs/not_recorded"},
    "attempts": {"$ref": "#/$defs/not_recorded"},
    "evidence_level": {"const": "engineering"}
  },
  "$defs": {
    "ref": {
      "type": "object", "required": ["path", "sha256"], "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "optional_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "relation": {"enum": ["known", "derived", "unknown"]},
    "existence": {"enum": ["not_generated", "recorded", "unreadable"]},
    "error": {"type": "object", "required": ["code", "message", "next_action"], "properties": {"code": {"const": "object_unreadable"}, "message": {"type": "string"}, "next_action": {"type": "string"}}, "additionalProperties": false},
    "not_recorded": {"type": "object", "required": ["status"], "properties": {"status": {"const": "not_recorded"}}, "additionalProperties": false},
    "applicability": {
      "type": "object", "required": ["status"], "additionalProperties": false,
      "properties": {
        "status": {"enum": ["current", "basis_changed", "unknown"]},
        "changed": {"type": "array", "items": {"type": "string"}},
        "checked": {"type": "array", "items": {"type": "string"}},
        "unverified": {"type": "array", "items": {"type": "string"}},
        "source": {"const": "stored_bindings"}
      }
    },
    "stage": {
      "type": "object", "required": ["ref", "scope", "existence", "applicability", "adoption", "relation"], "additionalProperties": false,
      "properties": {
        "ref": {"$ref": "#/$defs/optional_ref"},
        "scope": {"const": "per_page"},
        "existence": {"$ref": "#/$defs/existence"},
        "applicability": {"$ref": "#/$defs/applicability"},
        "adoption": {"enum": ["adopted_at_snapshot", "none"]},
        "relation": {"$ref": "#/$defs/relation"},
        "file": {"$ref": "#/$defs/ref"},
        "file_integrity": {"const": "checked_on_file_read"},
        "media_type": {"type": "string"},
        "dependencies": {"type": "array", "items": {"type": "object"}},
        "derived_from": {"type": "array", "items": {"$ref": "#/$defs/ref"}},
        "preview_of": {
          "type": "object", "required": ["scope", "ref", "relation"], "additionalProperties": false,
          "properties": {"scope": {"enum": ["per_page", "whole_deck"]}, "ref": {"$ref": "#/$defs/optional_ref"}, "relation": {"$ref": "#/$defs/relation"}, "revision_id": {"type": "string"}, "basis": {"type": "string"}}
        },
        "error": {"$ref": "#/$defs/error"}
      }
    },
    "stages": {
      "type": "object", "required": ["content", "blueprint", "svg", "svg_preview", "ppt_preview"], "additionalProperties": false,
      "properties": {"content": {"$ref": "#/$defs/stage"}, "blueprint": {"$ref": "#/$defs/stage"}, "svg": {"$ref": "#/$defs/stage"}, "svg_preview": {"$ref": "#/$defs/stage"}, "ppt_preview": {"$ref": "#/$defs/stage"}}
    },
    "page_summary": {
      "type": "object", "required": ["page_id", "title", "stages", "execution", "attention"], "additionalProperties": false,
      "properties": {"page_id": {"type": "string"}, "title": {"type": ["string", "null"]}, "stages": {"$ref": "#/$defs/stages"}, "execution": {"type": "array", "items": {"type": "object", "required": ["task_id", "kind", "status", "execution_ref"]}}, "attention": {"$ref": "#/$defs/not_recorded"}}
    },
    "deck_output": {
      "type": "object", "required": ["ref", "scope", "revision_id", "existence", "relation", "ordered_pages"], "additionalProperties": false,
      "properties": {
        "ref": {"$ref": "#/$defs/optional_ref"}, "scope": {"const": "whole_deck"}, "revision_id": {"type": "string"},
        "file": {"$ref": "#/$defs/ref"}, "file_integrity": {"const": "checked_on_file_read"},
        "existence": {"$ref": "#/$defs/existence"}, "relation": {"$ref": "#/$defs/relation"},
        "ordered_pages": {"type": "array", "items": {"type": "object", "required": ["page_id", "svg_sha256"], "additionalProperties": false, "properties": {"page_id": {"type": "string"}, "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}},
        "applicability": {"enum": ["current", "basis_changed", "unknown"]}, "basis": {"type": "string"}, "error": {"$ref": "#/$defs/error"}
      }
    }
  }
}
