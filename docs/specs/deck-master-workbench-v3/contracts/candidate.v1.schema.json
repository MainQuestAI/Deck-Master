{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "candidate.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "candidate.v1"},
    "candidate_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "task_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "result_kind": {"enum": ["artifact", "page", "content_update"]},
    "page_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "stage": {"enum": ["blueprint", "svg", "content"]},
    "base_revision": {"type": "string", "minLength": 1, "maxLength": 128},
    "generation_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page_ref": {"$ref": "#/$defs/ref"},
        "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "design_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "blueprint_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      },
      "required": ["page_ref", "input_digest", "design_digest", "blueprint_ref"]
    },
    "content_basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page_sequence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page_id": {"type": "string", "minLength": 1, "maxLength": 128},
              "page_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "required": ["page_id", "page_sha256"]
          }
        },
        "content_plan_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      },
      "required": ["input_digest", "page_sequence", "content_plan_ref"]
    },
    "request_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "attempt_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "target_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "result_ref": {"$ref": "#/$defs/ref"},
    "plan_input_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "status": {"const": "available"}
  },
  "required": [
    "schema_version",
    "candidate_id",
    "project_id",
    "task_id",
    "created_at",
    "base_revision",
    "result_ref",
    "status"
  ],
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "artifact_candidate": {
      "type": "object",
      "properties": {
        "result_kind": {"const": "artifact"},
        "stage": {"enum": ["blueprint", "svg"]}
      },
      "required": ["page_id", "stage", "generation_basis", "request_ref", "attempt_ref", "target_ref"]
    },
    "page_candidate": {
      "type": "object",
      "properties": {
        "result_kind": {"const": "page"},
        "stage": {"const": "content"},
        "attempt_ref": {"type": "null"}
      },
      "required": ["result_kind", "page_id", "stage", "generation_basis", "request_ref", "attempt_ref", "target_ref"]
    },
    "changeset_candidate": {
      "type": "object",
      "properties": {
        "result_kind": {"const": "content_update"},
        "stage": {"const": "content"},
        "target_ref": {"type": "null"}
      },
      "required": ["result_kind", "stage", "content_basis", "request_ref", "target_ref", "plan_input_ref"],
      "not": {"required": ["page_id"]}
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/artifact_candidate"},
    {"$ref": "#/$defs/page_candidate"},
    {"$ref": "#/$defs/changeset_candidate"}
  ]
}
