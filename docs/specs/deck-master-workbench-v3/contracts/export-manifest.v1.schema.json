{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "export_id",
    "project_identity",
    "revision_id",
    "purpose",
    "files",
    "excluded",
    "metadata_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "export_manifest.v1"
    },
    "export_id": {
      "type": "string",
      "pattern": "^export-[a-f0-9-]{36}$"
    },
    "project_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "revision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "purpose": {
      "enum": [
        "review",
        "delivery",
        "engineering"
      ]
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "size",
          "original_sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!/)[A-Za-z0-9_.\\-/]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "original_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "metadata_policy": {
      "enum": [
        "original_internal",
        "sanitized_public_copy"
      ]
    },
    "variant": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "description": "live/read variant metadata (CONTRACTS \u00a711.7): labels and fixed refs only; never a second content truth.",
          "additionalProperties": false,
          "required": [
            "group_id",
            "variant_id",
            "label",
            "narrative_ref",
            "plan_ref"
          ],
          "properties": {
            "group_id": {
              "type": "string",
              "minLength": 1
            },
            "variant_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]*$"
            },
            "label": {
              "type": "string",
              "minLength": 1
            },
            "narrative_ref": {
              "anyOf": [
                {
                  "$ref": "collaboration.v1.schema.json#/$defs/ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "plan_ref": {
              "anyOf": [
                {
                  "$ref": "collaboration.v1.schema.json#/$defs/ref"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    }
  }
}
