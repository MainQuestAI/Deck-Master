{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "operation_id",
    "input",
    "plan_id",
    "manifest_digest"
  ],
  "properties": {
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "scope",
        "reading_preferences"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "const": "current_project"
        },
        "draft_ids": {
          "oneOf": [
            {
              "const": "all"
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          ]
        },
        "reading_preferences": {
          "type": "boolean"
        }
      }
    },
    "plan_id": {
      "type": "string",
      "pattern": "^clear-plan-[a-f0-9]{16}$"
    },
    "manifest_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
