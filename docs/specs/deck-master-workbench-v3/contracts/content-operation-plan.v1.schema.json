{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "content_operation_plan.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "input": {
      "$ref": "content-operation-input.v1.schema.json"
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "changed_pages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "removed_pages": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "superseded_tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          }
        },
        "host_required": {
          "type": "boolean"
        },
        "preserved_originals_need_review": {
          "type": "boolean"
        },
        "deck_outputs_invalidated": {
          "type": "boolean"
        },
        "image_calls": {
          "const": 0
        }
      },
      "required": [
        "changed_pages",
        "removed_pages",
        "superseded_tasks",
        "host_required",
        "preserved_originals_need_review",
        "deck_outputs_invalidated",
        "image_calls"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "input",
    "impact"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
