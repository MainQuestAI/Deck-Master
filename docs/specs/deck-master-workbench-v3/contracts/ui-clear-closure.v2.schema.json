{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ui_clear_closure.v2"
    },
    "project_identity": {
      "type": "string"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "inspection_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "record_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "ended_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "bytes"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  },
  "required": [
    "schema_version",
    "project_identity",
    "operation_id",
    "request_digest",
    "inspection_digest",
    "record_digest",
    "ended_at",
    "evidence"
  ]
}
