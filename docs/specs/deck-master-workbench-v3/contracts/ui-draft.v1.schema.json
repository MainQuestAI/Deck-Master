{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ui_draft.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "project_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "draft_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "target": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_a7eb807f7f65"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_ref": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
    },
    "content": {
      "type": "object"
    },
    "pending": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_7214ef9e7b0a"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "project_identity",
    "draft_id",
    "target",
    "base_revision",
    "base_ref",
    "content",
    "pending"
  ]
}
