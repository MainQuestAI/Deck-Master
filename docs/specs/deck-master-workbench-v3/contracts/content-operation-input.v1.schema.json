{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "content_operation_input.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "content_plan_ref": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
    },
    "action": {
      "enum": [
        "edit",
        "reorder",
        "remove",
        "outline",
        "rewrite",
        "merge",
        "split"
      ]
    },
    "targets": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "shared-contracts.v1.schema.json#/$defs/d_d61b02986913"
      }
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "page_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    },
    "customer_visible": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "body_blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "shared-contracts.v1.schema.json#/$defs/d_66f4972db421"
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "bullets"
                  },
                  "heading": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/bullet_item"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "$ref": "shared-contracts.v1.schema.json#/$defs/d_dfc8981e8e73"
              }
            ]
          }
        },
        "labels": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_d8089dd1312c"
        },
        "footnotes": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_d8089dd1312c"
        },
        "callouts": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_f7e3128a3922"
        }
      },
      "required": [
        "title",
        "body_blocks"
      ],
      "additionalProperties": false
    },
    "content_plan": {
      "anyOf": [
        {
          "$ref": "content-plan-input.v1.schema.json"
        },
        {
          "$ref": "content-plan-input.v2.schema.json"
        }
      ]
    },
    "mode": {
      "enum": [
        "auto",
        "trial"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "content_plan_ref",
    "action",
    "targets",
    "instruction"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "bullet_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet_item"
          }
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
