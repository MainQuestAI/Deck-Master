{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "content_operation_input.v1"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "base_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "content_plan_ref": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "action": {
      "enum": [
        "edit",
        "reorder",
        "remove",
        "outline",
        "rewrite",
        "merge",
        "split"
      ]
    },
    "targets": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "page_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "required": [
          "page_id",
          "page_ref"
        ]
      }
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "page_order": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      }
    },
    "customer_visible": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "body_blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "paragraph"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "bullets"
                  },
                  "heading": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/bullet_item"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "table"
                  },
                  "title": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "cells": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "column_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                              },
                              "display_text": {
                                "type": "string"
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "string",
                                  "null"
                                ]
                              },
                              "unit": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "column_id",
                              "display_text"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "id",
                        "cells"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "columns",
                  "rows"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              },
              "tone": {
                "enum": [
                  "neutral",
                  "emphasis"
                ]
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "body_blocks"
      ],
      "additionalProperties": false
    },
    "content_plan": {
      "anyOf": [
        {
          "$ref": "content-plan-input.v1.schema.json"
        },
        {
          "$ref": "content-plan-input.v2.schema.json"
        }
      ]
    },
    "mode": {
      "enum": [
        "auto",
        "trial"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "content_plan_ref",
    "action",
    "targets",
    "instruction"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "bullet_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet_item"
          }
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
