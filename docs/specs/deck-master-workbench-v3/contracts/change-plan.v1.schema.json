{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "change_plan.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "change_plan.v1"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "payload_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "input": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "change_intent.v1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "change_intent.v1"
        },
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "base_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 300,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "page_ref": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "layer": {
                "enum": [
                  "content",
                  "prepared_prompt",
                  "submitted_prompt",
                  "original_image",
                  "svg",
                  "ppt"
                ]
              },
              "artifact_ref": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "path",
                      "sha256"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "path": {
                        "type": "string",
                        "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                      },
                      "sha256": {
                        "type": "string",
                        "pattern": "^[a-f0-9]{64}$"
                      }
                    }
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "stage": {
                "enum": [
                  "blueprint",
                  "reconstruct",
                  "repair"
                ]
              }
            },
            "required": [
              "page_id",
              "page_ref",
              "layer",
              "artifact_ref"
            ]
          }
        },
        "intent": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "instruction": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        },
        "annotation_refs": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          }
        },
        "max_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 300
        },
        "mode": {
          "enum": [
            "auto",
            "trial"
          ]
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "page_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "revision_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "artifact_ref": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              "role": {
                "enum": [
                  "reference",
                  "edit_target",
                  "supporting"
                ]
              }
            },
            "required": [
              "page_id",
              "revision_id",
              "artifact_ref",
              "role"
            ]
          },
          "maxItems": 16
        },
        "style_recipe_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "style_adopted_candidate_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "schema_version",
        "project_id",
        "base_revision",
        "targets",
        "intent",
        "instruction",
        "annotation_refs",
        "max_calls"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "action_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "page_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "page_ref": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            }
          },
          "layer": {
            "enum": [
              "content",
              "prepared_prompt",
              "submitted_prompt",
              "original_image",
              "svg",
              "ppt"
            ]
          },
          "target_ref": {
            "anyOf": [
              {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "kind": {
            "enum": [
              "repair",
              "reconstruct",
              "blueprint"
            ]
          },
          "write_slots": {
            "type": "array",
            "items": {
              "enum": [
                "page",
                "svg",
                "blueprint"
              ]
            }
          },
          "max_calls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "downstream": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "enum": [
              "auto",
              "trial"
            ]
          },
          "stage": {
            "enum": [
              "blueprint",
              "reconstruct",
              "repair"
            ]
          }
        },
        "required": [
          "action_id",
          "page_id",
          "page_ref",
          "layer",
          "target_ref",
          "kind",
          "write_slots",
          "max_calls",
          "downstream"
        ]
      }
    },
    "max_calls": {
      "type": "integer",
      "minimum": 0
    },
    "effects": {
      "type": "string"
    },
    "content_identity": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "payload_digest",
    "input",
    "actions",
    "max_calls",
    "effects",
    "content_identity"
  ]
}
