{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "operation_commit.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "operation_commit.v1"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "request_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_revision": {
      "type": "string",
      "minLength": 1
    },
    "committed_revision_id": {
      "type": "string",
      "minLength": 1
    },
    "result_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "operation_id",
    "kind",
    "project_id",
    "request_digest",
    "base_revision",
    "committed_revision_id",
    "result_ref"
  ]
}
