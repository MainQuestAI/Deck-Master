{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "style_recipe.v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "style_recipe.v2"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_df680d8bf82b"
    },
    "targets": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_a5022e8ab562"
    },
    "reference_sources": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c3018f846325"
    },
    "preserve_dimensions": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "propertyNames": {
        "enum": [
          "palette",
          "typography",
          "density",
          "lines",
          "composition",
          "spacing",
          "icons"
        ]
      }
    },
    "dimensions": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_47cf3a3e7a1e"
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "diff": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "preserve_target_content": {
      "const": true
    },
    "suggestion_state": {
      "enum": [
        "none",
        "unconfirmed",
        "confirmed"
      ]
    },
    "recipe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "parent_ref": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
    },
    "proposal_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "input",
    "targets",
    "reference_sources",
    "dimensions",
    "conflicts",
    "diff",
    "preserve_target_content",
    "suggestion_state",
    "recipe_id",
    "version",
    "parent_ref",
    "proposal_ref"
  ]
}
