{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "style_input.v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "style_input.v2"
    },
    "project_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "target_page_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      }
    },
    "instruction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "dimensions": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_47cf3a3e7a1e"
    },
    "host_suggestion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "resolutions": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "keep_target",
          "use_reference"
        ]
      }
    },
    "parent_recipe_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "visual_style_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "primary_reference_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "font_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "base_revision",
    "target_page_ids",
    "instruction",
    "visual_style_ref"
  ]
}
