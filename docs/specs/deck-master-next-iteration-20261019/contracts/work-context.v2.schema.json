{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.dev/contracts/work-context.v2.schema.json",
  "title": "Read-only deduplicated work context",
  "type": "object",
  "required": ["schema_version", "body_mode", "bodies", "context_ready", "resource_gaps", "host_application", "evidence_boundary"],
  "properties": {
    "schema_version": {"const": "work_context.v2"},
    "body_mode": {"enum": ["full", "delta", "manifest"]},
    "project_id": {"type": "string"},
    "current_revision": {"type": "string"},
    "revision_id": {"type": "string"},
    "tasks": {"type": "array", "items": {"type": "object"}},
    "pending_tasks": {"type": "array", "items": {"type": "object"}},
    "methods": {"type": "array", "items": {"$ref": "#/$defs/method"}},
    "entry_methods": {"type": "array", "items": {"$ref": "#/$defs/method"}},
    "bodies": {"type": "object", "additionalProperties": {"$ref": "#/$defs/body"}},
    "context_ready": {"type": "boolean"},
    "resource_gaps": {"type": "array", "items": {"$ref": "#/$defs/body"}},
    "host_application": {"const": "not_recorded"},
    "evidence_boundary": {"type": "string"}
  },
  "allOf": [{"if": {"properties": {"body_mode": {"const": "manifest"}}}, "then": {"properties": {"context_ready": {"const": false}}}}],
  "$defs": {
    "method": {
      "type": "object", "required": ["id", "relative_path", "sha256", "body_ref"],
      "properties": {"id": {"type": "string"}, "relative_path": {"type": "string"}, "sha256": {"type": ["string", "null"]}, "body_ref": {"type": "string"}},
      "additionalProperties": true
    },
    "body": {
      "type": "object", "required": ["kind", "state", "retrieval"],
      "properties": {
        "kind": {"enum": ["method", "source_extract", "page", "original_image", "work_order"]},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "state": {"enum": ["returned", "omitted_by_cache_offer", "manifest_only", "unavailable"]},
        "retrieval": {"type": "array", "minItems": 1, "items": {"type": "object"}},
        "content": {"type": "string"}, "byte_length": {"type": "integer", "minimum": 0},
        "encoding": {"enum": ["utf-8", "json-utf-8"]},
        "identity": {"type": "string"}, "reason": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "returned"}}}, "then": {"required": ["sha256", "content", "byte_length", "encoding"]}, "else": {"not": {"required": ["content"]}}},
        {"if": {"properties": {"state": {"const": "unavailable"}}}, "then": {"required": ["identity", "reason"]}, "else": {"required": ["sha256", "byte_length", "encoding"]}}
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
