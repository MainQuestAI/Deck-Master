{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "ui_method_preview.v1"
    },
    "project_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_status": {
      "enum": [
        "new_content_task",
        "frozen_pending_task",
        "read_only",
        "no_new_phase",
        "context_unavailable"
      ]
    },
    "browse_status": {
      "enum": [
        "available",
        "partial"
      ]
    },
    "dispatch_status": {
      "enum": [
        "new_content_task_possible",
        "cannot_dispatch",
        "not_applicable"
      ]
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "preparation_only": {
      "const": true
    },
    "selection_status": {
      "enum": [
        "validated",
        "not_evaluated"
      ]
    },
    "context": {
      "type": "object"
    },
    "catalog_digest": {
      "type": "string"
    },
    "context_digest": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "display_name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "selectable": {
            "type": "boolean"
          },
          "reason_codes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "display_name",
          "description",
          "kind",
          "sha256",
          "selectable",
          "reason_codes"
        ]
      }
    },
    "explicit_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "default_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resolved_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "relative_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "relative_path",
          "sha256"
        ]
      }
    },
    "preview_digest": {
      "type": "string"
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "const": "preparation_only"
        },
        "copy_allowed": {
          "type": "boolean"
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "status",
        "copy_allowed",
        "text"
      ]
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "revision_id",
    "context_status",
    "browse_status",
    "dispatch_status",
    "reason_codes",
    "preparation_only",
    "selection_status",
    "context",
    "catalog_digest",
    "context_digest",
    "entries",
    "explicit_ids",
    "default_ids",
    "dependency_ids",
    "resolved_manifest",
    "preview_digest",
    "handoff"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
