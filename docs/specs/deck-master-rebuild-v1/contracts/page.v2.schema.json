{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck_page_package.v2",
  "description": "Deck Master rebuild Spec Pack v1.1 pre-implementation contract clarification; synthetic examples are not production evidence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_page_package.v2"
    },
    "page_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "customer_visible": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "body_blocks": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "paragraph"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "type",
                  "text"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "bullets"
                  },
                  "heading": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/bullet_item"
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "items"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                  },
                  "type": {
                    "const": "table"
                  },
                  "title": {
                    "type": "string"
                  },
                  "columns": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "label": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "id",
                        "label"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "rows": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                        },
                        "cells": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "column_id": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                              },
                              "display_text": {
                                "type": "string"
                              },
                              "value": {
                                "type": [
                                  "number",
                                  "string",
                                  "null"
                                ]
                              },
                              "unit": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "column_id",
                              "display_text"
                            ],
                            "additionalProperties": false
                          }
                        }
                      },
                      "required": [
                        "id",
                        "cells"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "id",
                  "type",
                  "columns",
                  "rows"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "footnotes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "callouts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "text": {
                "type": "string"
              },
              "tone": {
                "enum": [
                  "neutral",
                  "emphasis"
                ]
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "body_blocks"
      ],
      "additionalProperties": false
    },
    "speaker_notes": {
      "type": "string"
    },
    "visual_spec": {
      "type": "object",
      "properties": {
        "intent": {
          "type": "string"
        },
        "layout_hint": {
          "type": "string"
        },
        "reference_mode": {
          "enum": [
            "faithful_reconstruction",
            "new_design"
          ]
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "node_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "label_ref": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "existing",
                  "proposed",
                  "out_of_scope",
                  "unspecified"
                ]
              },
              "responsibility_refs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "node_id",
              "label_ref",
              "status"
            ],
            "additionalProperties": false
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "edge_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "from": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "to": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "direction": {
                "enum": [
                  "forward",
                  "both",
                  "undirected"
                ]
              },
              "relationship": {
                "type": "string"
              },
              "label_ref": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "edge_id",
              "from",
              "to",
              "direction",
              "relationship"
            ],
            "additionalProperties": false
          }
        },
        "style_ref": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$",
          "description": "Document.design_context.styles[].style_id, not a path or mutable external URL."
        },
        "design_overrides": {
          "type": "object",
          "properties": {
            "language": {
              "type": "string",
              "minLength": 1
            },
            "body_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "heading_font_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "allowed_asset_ids": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "uniqueItems": true
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "intent",
        "reference_mode"
      ],
      "additionalProperties": false
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "locator": {
            "type": "string"
          },
          "supports": {
            "type": "string"
          },
          "claim_kind": {
            "enum": [
              "reported_fact",
              "inference",
              "design_proposal",
              "calculation",
              "target"
            ]
          },
          "expression": {
            "type": "string"
          },
          "input_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "source_id",
          "locator",
          "supports",
          "claim_kind"
        ],
        "additionalProperties": false
      }
    },
    "internal_only": {
      "type": "object",
      "properties": {
        "production_notes": {
          "type": "string"
        },
        "source_private_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "unresolved_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "page_id",
    "customer_visible",
    "visual_spec"
  ],
  "additionalProperties": false,
  "$defs": {
    "bullet_item": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "text": {
          "type": "string"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bullet_item"
          }
        }
      },
      "required": [
        "id",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
