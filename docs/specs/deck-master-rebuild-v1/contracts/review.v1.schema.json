{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck_review.v1",
  "description": "Deck Master rebuild Spec Pack v1.1 pre-implementation contract clarification; synthetic examples are not production evidence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_review.v1"
    },
    "review_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "kind": {
      "enum": [
        "content",
        "blueprint_content",
        "blueprint_fidelity",
        "conversion",
        "readability",
        "privacy",
        "professional_use",
        "desktop_editing"
      ]
    },
    "review_stage": {
      "enum": [
        "page_visual",
        "final"
      ]
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "needs_review",
        "not_evaluated",
        "not_applicable"
      ]
    },
    "subjects": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
    },
    "dependencies": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_b21abcbdb54e"
    },
    "reviewer": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "tool",
            "host_self",
            "independent_host",
            "human_internal",
            "human_external"
          ]
        },
        "id": {
          "type": "string"
        },
        "execution_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "independence_confirmed": {
          "type": "boolean"
        },
        "identity_receipt": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_49471c70c6f5"
        }
      },
      "required": [
        "type",
        "id",
        "execution_ref",
        "independence_confirmed"
      ],
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_f7bca7e4875c"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "replaces": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_c638eb3aa914"
    }
  },
  "required": [
    "schema_version",
    "review_id",
    "kind",
    "status",
    "subjects",
    "dependencies",
    "reviewer",
    "observations",
    "findings",
    "created_at",
    "replaces"
  ],
  "additionalProperties": false
}
