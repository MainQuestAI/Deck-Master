{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck_task.v1",
  "description": "Deck Master rebuild Spec Pack v1.1 pre-implementation contract clarification; synthetic examples are not production evidence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_task.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "kind": {
      "enum": [
        "compose",
        "blueprint",
        "reconstruct",
        "review",
        "repair",
        "compile",
        "render",
        "check"
      ]
    },
    "review_stage": {
      "enum": ["page_visual", "final"]
    },
    "status": {
      "enum": [
        "queued",
        "awaiting_host",
        "running",
        "completed",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "scope_pages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "instruction": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "content",
              "source",
              "blueprint",
              "svg",
              "asset",
              "style",
              "toolchain",
              "artifact",
              "policy"
            ]
          },
          "identity": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "identity",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "dispatch_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "produced_against": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "next_action": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "next_action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cost_class": {
      "enum": [
        "local_compute",
        "external_generation",
        "host_reasoning"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "not_reported",
            "host_reported"
          ]
        },
        "external_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "source",
        "external_calls"
      ],
      "additionalProperties": false,
      "description": "Post-call observation only, not permission to issue calls. call_allowances are allocated by the project transaction."
    },
    "call_allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "allowance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "state": {
            "enum": [
              "reserved",
              "in_flight",
              "consumed",
              "released",
              "unknown"
            ]
          },
          "execution_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "invocation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            }
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "host_reported",
              "provider_verified"
            ]
          }
        },
        "required": [
          "allowance_id",
          "state",
          "execution_ref",
          "invocation_ref",
          "evidence"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "operation_id",
    "kind",
    "status",
    "scope_pages",
    "instruction",
    "inputs",
    "dependencies",
    "dispatch_revision",
    "produced_against",
    "result_refs",
    "error",
    "execution_ref",
    "created_at",
    "updated_at",
    "cost_class",
    "usage",
    "call_allowances"
  ],
  "additionalProperties": false
}
