{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck_task.v1",
  "description": "Deck Master rebuild Spec Pack v1.1 pre-implementation contract clarification; synthetic examples are not production evidence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_task.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "kind": {
      "enum": [
        "compose",
        "blueprint",
        "reconstruct",
        "review",
        "repair",
        "compile",
        "render",
        "check",
        "style_analyze"
      ]
    },
    "review_stage": {
      "enum": [
        "preproduction",
        "page_visual",
        "final",
        "original_image"
      ],
      "description": "Content collaboration v1.2 CONTRACTS \u00a76.3/\u00a711.6: a preproduction review is bound to the current Narrative/Plan/Page manuscript and its source dependencies."
    },
    "status": {
      "enum": [
        "queued",
        "awaiting_host",
        "running",
        "completed",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "scope_pages": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
      }
    },
    "instruction": {
      "type": "string"
    },
    "inputs": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
    },
    "dependencies": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_b21abcbdb54e"
    },
    "dispatch_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "produced_against": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result_refs": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
    },
    "error": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "string"
            },
            "message": {
              "type": "string"
            },
            "next_action": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "message",
            "next_action"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "execution_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "cost_class": {
      "enum": [
        "local_compute",
        "external_generation",
        "host_reasoning"
      ]
    },
    "usage": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "not_reported",
            "host_reported"
          ]
        },
        "external_calls": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "source",
        "external_calls"
      ],
      "additionalProperties": false,
      "description": "Post-call observation only, not permission to issue calls. call_allowances are allocated by the project transaction."
    },
    "call_allowances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "allowance_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "state": {
            "enum": [
              "reserved",
              "in_flight",
              "consumed",
              "released",
              "unknown"
            ]
          },
          "execution_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "invocation_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
          },
          "evidence_level": {
            "type": "string",
            "enum": [
              "host_reported",
              "provider_verified",
              "tool_observed"
            ]
          }
        },
        "required": [
          "allowance_id",
          "state",
          "execution_ref",
          "invocation_ref",
          "evidence"
        ],
        "additionalProperties": false
      }
    },
    "intent": {
      "enum": [
        "initial",
        "input_revision",
        "import_draft"
      ],
      "description": "Compose split: initial writes the first full deck; input_revision submits only changed pages (spec v1.1 5.4)."
    },
    "input_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "input_digest (spec v1.1 5.1) of the task facts and sources at dispatch time."
    },
    "input_revision_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Operation id of the inputs update this task works against."
    },
    "method_release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_id",
        "methods_sha256"
      ],
      "properties": {
        "release_id": {
          "type": "string"
        },
        "methods_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "description": "Which method release the task was dispatched with; traceability only, no snapshot (spec v1.1 3.4)."
    },
    "review_units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "page_ids",
          "reason"
        ],
        "properties": {
          "kind": {
            "enum": [
              "content",
              "blueprint_content",
              "blueprint_fidelity",
              "conversion",
              "readability",
              "privacy",
              "argument",
              "page_copy",
              "progression",
              "speech",
              "visual_expression"
            ]
          },
          "page_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "enum": [
              "missing",
              "stale",
              "open_finding",
              "changed_input"
            ]
          }
        }
      },
      "description": "Final review dispatched by actual gap only (spec v1.1 6)."
    },
    "protocol_version": {
      "enum": [
        "generation.v1",
        "compose.v1",
        "compose.v2",
        "changes.v1"
      ],
      "description": "compose.v2 selects the phased result protocol (CONTRACTS \u00a711.5); compose.v1 remains readable for historical tasks and receipts only."
    },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "host_protocol": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "supported_protocols": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "supported_protocols",
        "capabilities"
      ]
    },
    "generation_requests": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
    },
    "generation_attempts": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
    },
    "change_binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "change_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "change_ref",
        "action_id"
      ]
    },
    "stage_request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "auto",
            "trial"
          ]
        },
        "stage": {
          "enum": [
            "blueprint",
            "reconstruct",
            "repair",
            "content"
          ]
        },
        "references": {
          "$ref": "shared-contracts.v1.schema.json#/$defs/d_25a2c6e4baa2"
        },
        "style_recipe_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "icon_recipe_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "target_reference_ref": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          }
        },
        "speech_kind": {
          "enum": [
            "cue",
            "verbatim"
          ],
          "description": "Content collaboration v1.2 CONTRACTS \u00a71.7/\u00a710.1: the speech segment kind this phase was dispatched for (cue = cues). The Runtime derives it from the plan speech policy or an explicit instruction; a Host result cannot pick it."
        }
      },
      "required": [
        "mode",
        "stage",
        "references"
      ]
    },
    "candidate_refs": {
      "$ref": "shared-contracts.v1.schema.json#/$defs/d_e21310f9468f"
    },
    "execution_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Core-recorded first task_start time for this execution; absent means not recorded."
    },
    "content_operation_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "analysis_request_ref": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "collaboration_binding": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "description": "Task collaboration binding (CONTRACTS \u00a75). Required for newly dispatched tasks once the writer boundary is collaboration.v1.",
          "additionalProperties": false,
          "required": [
            "request_id",
            "phase",
            "executor_type",
            "authorization_ref",
            "decision_refs",
            "write_scope",
            "adoption_policy",
            "eligibility_basis",
            "eligibility_digest"
          ],
          "properties": {
            "request_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "phase": {
              "enum": [
                "framing",
                "argument",
                "page_copy",
                "speech",
                "design",
                "production",
                "review",
                "delivery"
              ]
            },
            "executor_type": {
              "enum": [
                "runtime",
                "host",
                "external_reviewer"
              ]
            },
            "authorization_ref": {
              "anyOf": [
                {
                  "$ref": "collaboration.v1.schema.json#/$defs/ref"
                },
                {
                  "type": "null"
                }
              ]
            },
            "decision_refs": {
              "type": "array",
              "items": {
                "$ref": "collaboration.v1.schema.json#/$defs/ref"
              }
            },
            "write_scope": {
              "$ref": "collaboration.v1.schema.json#/$defs/scope"
            },
            "adoption_policy": {
              "enum": [
                "proposal_only",
                "candidate_only",
                "within_scope"
              ]
            },
            "eligibility_basis": {
              "type": "array",
              "items": {
                "$ref": "collaboration.v1.schema.json#/$defs/dependency_slice"
              }
            },
            "eligibility_digest": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "budget_key": {
              "type": "string",
              "minLength": 1,
              "description": "Runtime-computed per-page credit; consumption remains in call_allowances."
            }
          }
        }
      ]
    },
    "method_manifest": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "relative_path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "relative_path": {
            "type": "string",
            "pattern": "^(references|assets|scripts)/[A-Za-z0-9_./-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "content_validation_policy": {
      "enum": [
        "argument-connectivity.v1"
      ]
    },
    "review_subject": {
      "enum": [
        "outline"
      ],
      "description": "Explicit outline-only subject; absent retains the original manuscript contract."
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "operation_id",
    "kind",
    "status",
    "scope_pages",
    "instruction",
    "inputs",
    "dependencies",
    "dispatch_revision",
    "produced_against",
    "result_refs",
    "error",
    "execution_ref",
    "created_at",
    "updated_at",
    "cost_class",
    "usage",
    "call_allowances"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "review_stage": {
            "const": "original_image"
          }
        },
        "required": [
          "review_stage"
        ]
      },
      "then": {
        "properties": {
          "kind": {
            "const": "review"
          },
          "scope_pages": {
            "minItems": 1,
            "maxItems": 1
          },
          "required_capabilities": {
            "contains": {
              "const": "original_expression_review.v1"
            }
          }
        },
        "required": [
          "required_capabilities"
        ]
      }
    },
    {
      "if": {
        "required": [
          "review_subject"
        ],
        "properties": {
          "review_subject": {
            "const": "outline"
          }
        }
      },
      "then": {
        "properties": {
          "review_stage": {
            "const": "preproduction"
          },
          "kind": {
            "const": "review"
          },
          "scope_pages": {
            "maxItems": 0
          },
          "required_capabilities": {
            "contains": {
              "const": "outline_review.v1"
            }
          }
        },
        "required": [
          "review_stage",
          "required_capabilities"
        ]
      }
    }
  ]
}
