{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deck_artifact.v1",
  "description": "Deck Master rebuild Spec Pack v1.1 pre-implementation contract clarification; synthetic examples are not production evidence.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_artifact.v1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "page_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "role": {
      "enum": [
        "blueprint",
        "svg",
        "svg_preview",
        "pptx",
        "ppt_preview",
        "object_trace",
        "render_report",
        "source_extract",
        "comparison_crop",
        "asset"
      ]
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "media_type": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "content",
              "source",
              "blueprint",
              "svg",
              "asset",
              "style",
              "toolchain",
              "artifact",
              "policy"
            ]
          },
          "identity": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "kind",
          "identity",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "derived_from": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "source_type": {
          "enum": [
            "host_generated",
            "user_supplied",
            "tool_generated",
            "legacy_import",
            "unknown"
          ]
        },
        "tool": {
          "type": "string"
        },
        "invocation_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "submitted_prompt": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "generated_from_page": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "path",
                "sha256"
              ],
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source_type"
      ],
      "additionalProperties": false
    },
    "reference_regions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "description": {
            "type": "string"
          },
          "bbox_normalized": {
            "type": "array",
            "items": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "expected_text_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expected_relation_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "importance": {
            "enum": [
              "essential",
              "supporting",
              "decorative"
            ]
          }
        },
        "required": [
          "region_id",
          "description",
          "importance"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "editability": {
      "enum": [
        "editable_shapes_and_text",
        "not_applicable",
        "unknown"
      ],
      "description": "Shape/text editability only; never implies Office Edit Data or native table-cell capability."
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "page_id",
    "role",
    "file",
    "media_type",
    "created_at",
    "dependencies",
    "derived_from",
    "provenance",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "role": {
            "const": "pptx"
          }
        },
        "required": [
          "role"
        ]
      },
      "then": {
        "required": [
          "editability"
        ]
      }
    }
  ]
}
