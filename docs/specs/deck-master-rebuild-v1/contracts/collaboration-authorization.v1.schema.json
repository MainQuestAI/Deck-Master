{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "collaboration_authorization.v1",
  "description": "Authorization object (content collaboration v1.2 CONTRACTS \u00a73.2). All execution grants carry an integer call ceiling (0 when not yet materialised); the existing allowance ledger stays the single cost record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "project_id",
    "request_id",
    "mode",
    "actions",
    "scope",
    "decision_refs",
    "delegated_topics",
    "constraints",
    "max_external_calls",
    "max_candidate_count",
    "budget_template",
    "budget_parent_ref",
    "budget_key",
    "adoption_policy",
    "delivery_binding",
    "evidence",
    "basis",
    "parent_authorization_ref",
    "replaces",
    "status",
    "expires_at",
    "stop_conditions",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "collaboration_authorization.v1"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "mode": {
      "enum": [
        "execute",
        "delegate"
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "scope": {
      "$ref": "collaboration.v1.schema.json#/$defs/scope"
    },
    "decision_refs": {
      "type": "array",
      "items": {
        "$ref": "collaboration.v1.schema.json#/$defs/ref"
      }
    },
    "delegated_topics": {
      "type": "array",
      "items": {
        "enum": [
          "direction",
          "manuscript",
          "speech",
          "style",
          "tradeoff",
          "delivery_acceptance",
          "policy"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "description": "Explicit boundaries (page count, style, density, delivery). future_pages is the \u00a73.4 delegate selector.",
      "properties": {
        "future_pages": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "selector",
            "max_pages",
            "max_pages_basis"
          ],
          "properties": {
            "selector": {
              "const": "adopted_plan_for_this_request"
            },
            "max_pages": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "max_pages_basis": {
              "enum": [
                "provided",
                "delegated",
                "pending"
              ]
            }
          }
        }
      }
    },
    "max_external_calls": {
      "type": "integer",
      "minimum": 0
    },
    "max_candidate_count": {
      "type": "integer",
      "minimum": 0
    },
    "budget_template": {
      "anyOf": [
        {
          "enum": [
            "initial_per_page",
            "edit_rebuild_per_page",
            "explicit"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_parent_ref": {
      "anyOf": [
        {
          "$ref": "collaboration.v1.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "budget_key": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "adoption_policy": {
      "enum": [
        "candidate_only",
        "within_scope"
      ]
    },
    "delivery_binding": {
      "enum": [
        "none",
        "process_delegation",
        "exact_artifact"
      ]
    },
    "evidence": {
      "$ref": "collaboration.v1.schema.json#/$defs/evidence"
    },
    "basis": {
      "type": "array",
      "items": {
        "$ref": "collaboration.v1.schema.json#/$defs/dependency_slice"
      }
    },
    "parent_authorization_ref": {
      "anyOf": [
        {
          "$ref": "collaboration.v1.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "replaces": {
      "anyOf": [
        {
          "$ref": "collaboration.v1.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "active",
        "paused",
        "revoked",
        "superseded",
        "invalidated"
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "stop_conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
