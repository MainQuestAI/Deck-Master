{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "narrative.v1",
  "description": "Narrative (content collaboration v1.2 CONTRACTS \u00a711.1): the single semantic/argument truth source. It carries no confirmed flag; adoption is a Decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "narrative_id",
    "version",
    "project_id",
    "origin",
    "maturity",
    "input_basis",
    "communication_job",
    "central_node_id",
    "nodes",
    "edges",
    "issues",
    "alternatives",
    "previous_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "narrative.v1"
    },
    "narrative_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "origin": {
      "enum": [
        "host_composed",
        "user_imported",
        "user_edited"
      ]
    },
    "maturity": {
      "enum": [
        "framing",
        "argument"
      ]
    },
    "input_basis": {
      "type": "array",
      "items": {
        "$ref": "collaboration.v1.schema.json#/$defs/dependency_slice"
      }
    },
    "communication_job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "audience_fact_key",
        "audience_question",
        "desired_outcome",
        "observable_success",
        "use_mode",
        "primary_use"
      ],
      "properties": {
        "mode": {
          "enum": [
            "explain",
            "train",
            "report",
            "decide",
            "persuade",
            "mixed"
          ]
        },
        "audience_fact_key": {
          "type": "string",
          "minLength": 1
        },
        "audience_question": {
          "type": "string",
          "minLength": 1
        },
        "desired_outcome": {
          "type": "string",
          "minLength": 1
        },
        "observable_success": {
          "type": "string",
          "minLength": 1
        },
        "use_mode": {
          "enum": [
            "live",
            "read_alone",
            "mixed",
            "undecided"
          ]
        },
        "primary_use": {
          "anyOf": [
            {
              "enum": [
                "live",
                "read_alone"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "central_node_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "node_id",
          "role",
          "statement",
          "authority",
          "source_links",
          "qualification_node_ids",
          "unresolved_issue_ids"
        ],
        "properties": {
          "node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "role": {
            "enum": [
              "claim",
              "evidence",
              "reasoning",
              "qualification",
              "objection",
              "recommendation",
              "explanation",
              "example"
            ]
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "authority": {
            "enum": [
              "reported_fact",
              "inference",
              "calculation",
              "recommendation",
              "target",
              "hypothesis",
              "instruction"
            ]
          },
          "source_links": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_id",
                "source_version",
                "locator"
              ],
              "properties": {
                "source_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "source_version": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "original_sha256",
                    "extract"
                  ],
                  "properties": {
                    "original_sha256": {
                      "anyOf": [
                        {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "extract": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "path",
                        "sha256"
                      ],
                      "properties": {
                        "path": {
                          "type": "string",
                          "pattern": "^\\.deckmaster/objects/[a-f0-9]{2}/[a-f0-9]{64}\\.[a-z0-9]+$"
                        },
                        "sha256": {
                          "type": "string",
                          "pattern": "^[a-f0-9]{64}$"
                        }
                      }
                    }
                  }
                },
                "locator": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "\\S"
                }
              }
            }
          },
          "qualification_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "unresolved_issue_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_node_id",
          "to_node_id",
          "relation"
        ],
        "properties": {
          "from_node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "to_node_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "relation": {
            "enum": [
              "supports",
              "qualifies",
              "challenges",
              "explains",
              "prerequisite",
              "leads_to",
              "illustrates"
            ]
          }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "question",
          "impact",
          "affected_node_ids",
          "resolution",
          "resolution_ref"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "impact": {
            "enum": [
              "blocker",
              "needs_judgment",
              "advisory"
            ]
          },
          "affected_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          },
          "resolution": {
            "enum": [
              "open",
              "resolved",
              "accepted_limit"
            ]
          },
          "resolution_ref": {
            "anyOf": [
              {
                "$ref": "collaboration.v1.schema.json#/$defs/ref"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "option_id",
          "description",
          "benefit",
          "cost",
          "affected_node_ids"
        ],
        "properties": {
          "option_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "benefit": {
            "type": "string",
            "minLength": 1
          },
          "cost": {
            "type": "string",
            "minLength": 1
          },
          "affected_node_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            }
          }
        }
      }
    },
    "previous_ref": {
      "anyOf": [
        {
          "$ref": "collaboration.v1.schema.json#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
