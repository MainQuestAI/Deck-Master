    "color_delta_max": 0.08,
    "bbox_delta_px_max": 1.0,
    "occupancy_delta_max": 0.12
  },
  "renderer_tolerance": {
    "alignment_radius_px": 4,
    "silhouette_luma_threshold": 225,
    "edge_delta_threshold": 2,
    "edge_dilation_kernel": 5,
    "local_match_blur_radius_px": 1.0
