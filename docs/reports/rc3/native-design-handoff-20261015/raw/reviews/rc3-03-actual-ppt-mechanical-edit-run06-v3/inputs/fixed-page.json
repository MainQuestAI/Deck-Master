  "customer_visible": {
    "body_blocks": [
      {
        "id": "exceptions-heading",
        "text": "未知与不适用信息仍随请求交接",
        "type": "paragraph"
      },
      {
        "columns": [
          {
            "id": "trigger",
            "label": "触发条件"
          },
          {
            "id": "action",
            "label": "接单人员动作"
          },
          {
            "id": "handoff",
            "label": "交接及继续条件"
          }
        ],
        "id": "exceptions",
        "rows": [
          {
            "cells": [
              {
                "column_id": "trigger",
                "display_text": "型号或版本待补／确实不可得"
              },
              {
                "column_id": "action",
                "display_text": "保留已知条件、未知字段及原因；能补则请求可核对信息，不能强制填入猜测。"
              },
              {
                "column_id": "handoff",
                "display_text": "不能补出时交指定业务核查人判断下一步；取得可核查条件后按主链继续。具体责任人与恢复规则须在启动前明确。"
              }
            ],
            "id": "unknown"
          },
          {
            "cells": [
              {
                "column_id": "trigger",
                "display_text": "引用适用性无法确认、引用冲突／不适用，或问题仍不确定"
              },
              {
                "column_id": "action",
                "display_text": "保留设备条件、来源位置和未决点；候选引用不能标成可直接采用的结论。"
              },
              {
                "column_id": "handoff",
                "display_text": "交核查人确认资料适用性和下一步；无法确认则继续标明未决，不把找到资料记为故障已解决。"
              }
            ],
            "id": "unsuitable"
          }
        ],
        "type": "table"
      }
    ],
    "callouts": [
      {
        "id": "boundary",
        "text": "原始范围：AI 不自动提交、修改或关闭正式工单，未知及原因必须保留。能力边界：引用问答不等于诊断正确或操作获批。"
      }
    ],
    "footnotes": [],
    "labels": [
      {
        "id": "collect",
        "text": "现场人员提供型号、版本与现象；接单人员核对可核查条件。"
      },
      {
        "id": "retrieve",
        "text": "只读助手返回许可资料片段及来源。"
      },
      {
        "id": "review",
        "text": "指定人员核查引用适用性，记录采用／未采用及原因。"
      },
      {
        "id": "submit",
        "text": "人员在现有系统完成正式提交。"
      }
    ],
    "subtitle": "首次人员提交前做条件提示；能否减少后续补问仍待验证",
    "title": "建议流程保留两条分支：条件可核对／条件未知"
  },
  "internal_only": {
    "production_notes": "仅提交页面内容及关系要求，未生成视觉成品。沿用当前全局设计；正文中的限定不得删去或挪入备注。口播由对应阶段处理，本阶段 speaker_notes 为空。",
