                    operation_id=operation_id,
                    task_id=task_id,
                    kind=envelope["kind"],
                    produced_against=produced_against,
                    result_digest=result_digest,
                    revision_id=document["revision_id"],
                    status="late_result_settled",
                    usage_events=envelope.get("usage_events") or [],
