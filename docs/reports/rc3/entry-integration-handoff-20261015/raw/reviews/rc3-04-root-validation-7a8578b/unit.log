                    "operation_id": f"settle-{operation_id}",
                    "kind": "task_update",
                    "description": "late result after cancellation; call facts settled",
                    "read_set": [],
                },
            )
            bumped = _replace_task_ref(bumped, task, task_ref, store)
            store._commit_locked(
