{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/svg-to-drawingml-trace.v1.schema.json",
  "title": "SVG to DrawingML Trace v1",
  "type": "object",
  "required": ["schema_version", "run_id", "page_id", "svg_sha256", "pptx_sha256", "pages", "elements", "coverage", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_svg_to_drawingml_trace.v1"},
    "run_id": {"type": "string"},
    "page_id": {"type": "string"},
    "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pptx_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pages": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["page_id", "svg_sha256", "elements", "speaker_notes_present"], "properties": {"page_id": {"type": "string", "minLength": 1}, "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "elements": {"type": "array"}, "speaker_notes_present": {"type": "boolean"}}, "additionalProperties": false}},
    "elements": {"type": "array", "items": {"type": "object", "required": ["element_id", "object_type", "shape_name", "bbox", "priority", "component_id", "z_order"], "properties": {"element_id": {"type": "string", "minLength": 1}, "object_type": {"enum": ["text", "shape", "line", "freeform", "group", "registered_asset"]}, "shape_name": {"type": "string", "minLength": 1}, "bbox": {"type": "object", "required": ["x", "y", "w", "h"]}, "priority": {"enum": ["P0", "P1", "P2"]}, "component_id": {"type": "string", "minLength": 1}, "z_order": {"type": "integer"}, "text": {"type": "string"}, "text_ref": {"type": "string"}, "runs": {"type": "array"}, "asset_id": {"type": "string"}, "closed": {"type": "boolean"}, "paint": {"type": "object"}, "effect": {"type": "object"}, "group_id": {"type": "string"}, "visual_id": {"type": "string"}, "children": {"type": "array"}, "child_element_ids": {"type": "array"}, "normalized_path": {"type": "string"}, "path_commands": {"type": "array"}, "fidelity": {"type": "string"}, "stroke_linecap": {"type": "string"}, "stroke_linejoin": {"type": "string"}, "stroke_opacity": {"type": "number"}, "fill_rule": {"type": "string"}}, "additionalProperties": false}},
    "coverage": {"type": "object", "required": ["p0_p1", "visual_registry", "groups"], "properties": {"p0_p1": {"const": "pass"}, "visual_registry": {"const": "pass"}, "groups": {"const": "pass"}}, "additionalProperties": false},
    "unsupported": {"type": "array", "items": {"type": "object"}},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
