{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/high-density-manifest.v2.schema.json",
  "title": "High-Density Manifest v2",
  "type": "object",
  "required": ["schema_version", "run_id", "builder_profile", "source_fingerprint", "status", "pages", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_high_density_manifest.v2"},
    "run_id": {"type": "string"},
    "builder_profile": {"const": "high_density"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "mbb_plan": {"type": "object"},
    "style_lock": {"type": "object"},
    "status": {"enum": ["building", "completed", "blocked", "stale"]},
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page_id", "order", "page_role"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1},
          "page_role": {"enum": ["cover", "section", "section_divider", "divider", "toc", "agenda", "visual", "visual_divider", "image", "image_page", "dense_narrative", "content", "framework", "architecture", "comparison", "data_story", "process", "table"]}
        },
        "additionalProperties": true
      }
    },
    "created_at": {"type": "string"},
    "completed_at": {"type": "string"}
  },
  "additionalProperties": true
}
