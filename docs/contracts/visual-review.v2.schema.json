{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/visual-review.v2.schema.json",
  "title": "Deck Visual Review v2",
  "type": "object",
  "required": ["schema_version", "run_id", "page_id", "svg_sha256", "blueprint_sha256", "blueprint_preview_sha256", "svg_preview_sha256", "review_mode", "metrics_ref", "metrics_sha256", "visual_status", "full_page_checks", "region_checks", "issues_found", "unresolved_issues", "self_review", "main_review", "verdict", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_visual_review.v2"},
    "run_id": {"type": "string"},
    "page_id": {"type": "string"},
    "review_mode": {"type": "string"},
    "blueprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blueprint_preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "svg_preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metrics_ref": {"type": "string"},
    "metrics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "full_page_checks": {"type": "object", "required": ["canvas_ratio", "stable_ids", "p0_p1_geometry"], "additionalProperties": {"enum": ["pass", "failed"]}},
    "region_checks": {"type": "array", "items": {"type": "object"}},
    "issues_found": {"type": "array", "items": {"type": "object"}},
    "unresolved_issues": {"type": "array", "items": {"type": "object"}},
    "self_review": {"type": "object", "required": ["status", "source"], "properties": {"status": {"enum": ["pass", "failed", "pending"]}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "main_review": {"type": "object", "required": ["status", "source"], "properties": {"status": {"enum": ["pass", "failed", "pending"]}, "source": {"type": "string", "minLength": 1}}, "additionalProperties": true},
    "visual_status": {"enum": ["pass", "failed", "needs_review"]},
    "verdict": {"enum": ["pass", "fail", "needs_review"]},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
