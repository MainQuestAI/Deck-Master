{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/visual-review.v2.schema.json",
  "title": "Deck Visual Review v2",
  "type": "object",
  "required": ["schema_version", "run_id", "page_id", "svg_sha256", "blueprint_sha256", "blueprint_preview_sha256", "svg_preview_sha256", "review_mode", "metrics_ref", "metrics_sha256", "runtime_challenge", "visual_status", "full_page_checks", "region_checks", "icon_checks", "curve_checks", "table_checks", "issues_found", "unresolved_issues", "self_review", "main_review", "verdict", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_visual_review.v2"},
    "run_id": {"type": "string"},
    "page_id": {"type": "string"},
    "review_mode": {"type": "string"},
    "blueprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "blueprint_preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "svg_preview_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "metrics_ref": {"type": "string"},
    "metrics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "full_page_checks": {"type": "object", "required": ["canvas_ratio", "stable_ids", "p0_p1_geometry", "layout", "mask_coverage"], "properties": {"canvas_ratio": {"enum": ["pass", "failed"]}, "stable_ids": {"enum": ["pass", "failed"]}, "p0_p1_geometry": {"enum": ["pass", "failed"]}, "layout": {"enum": ["pass", "failed"]}, "mask_coverage": {"type": "number", "minimum": 0, "maximum": 0.2}, "icon_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "curve_coverage": {"type": "number", "minimum": 0, "maximum": 1}, "table_coverage": {"type": "number", "minimum": 0, "maximum": 1}}, "additionalProperties": false},
    "region_checks": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/regionCheck"}},
    "icon_checks": {"type": "array", "items": {"$ref": "#/$defs/objectCheck"}},
    "curve_checks": {"type": "array", "items": {"$ref": "#/$defs/objectCheck"}},
    "table_checks": {"type": "array", "items": {"$ref": "#/$defs/objectCheck"}},
    "issues_found": {"type": "array", "items": {"type": "object"}},
    "unresolved_issues": {"type": "array", "items": {"type": "object"}},
    "runtime_challenge": {
      "type": "object",
      "required": ["self_action_id", "main_action_id", "svg_sha256", "blueprint_sha256", "metrics_sha256", "issued_at", "integrity"],
      "properties": {
        "self_action_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "main_action_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "blueprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "metrics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "issued_at": {"type": "string", "format": "date-time"},
        "integrity": {"$ref": "#/$defs/integrity"}
      },
      "additionalProperties": false
    },
    "self_review": {"$ref": "#/$defs/reviewEvidence"},
    "main_review": {
      "allOf": [
        {"$ref": "#/$defs/reviewEvidence"},
        {"type": "object", "required": ["self_review_sha256"], "properties": {"self_review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}}
      ]
    },
    "visual_status": {"enum": ["pass", "failed", "needs_review"]},
    "verdict": {"enum": ["pass", "fail", "needs_review"]},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "integrity": {
      "type": "object",
      "required": ["algorithm", "key_id", "payload_sha256", "signature"],
      "properties": {
        "algorithm": {"const": "hmac-sha256"},
        "key_id": {"type": "string", "pattern": "^[a-f0-9]{16}$"},
        "payload_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "signature": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "reviewEvidence": {
      "type": "object",
      "required": ["status", "source", "reviewer_id", "action_id", "reviewed_at", "svg_sha256", "blueprint_sha256", "metrics_sha256", "full_page_check", "region_check_ids", "issues_found", "revision_required", "evidence_sha256"],
      "properties": {
        "status": {"enum": ["pass", "failed", "pending"]},
        "source": {"type": "string", "minLength": 1},
        "reviewer_id": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "pattern": "^[a-f0-9]{32}$"},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "blueprint_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "metrics_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "full_page_check": {"enum": ["pass", "failed", "pending"]},
        "region_check_ids": {"type": "array", "minItems": 4, "items": {"type": "string", "minLength": 1}},
        "issues_found": {"type": "array", "items": {"type": "object"}},
        "revision_required": {"type": "boolean"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "self_review_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "regionCheck": {
      "type": "object",
      "required": ["region_id", "status", "bbox", "issue_count", "notes", "evidence_sha256"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "failed", "pending"]},
        "bbox": {"type": "object", "required": ["x", "y", "w", "h"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "w": {"type": "number", "minimum": 0}, "h": {"type": "number", "minimum": 0}}, "additionalProperties": false},
        "issue_count": {"type": "integer", "minimum": 0},
        "notes": {"type": "string"},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "objectCheck": {
      "type": "object",
      "required": ["visual_id", "status", "evidence_sha256"],
      "properties": {
        "visual_id": {"type": "string", "minLength": 1},
        "status": {"enum": ["pass", "failed", "pending"]},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "notes": {"type": "string"}
      },
      "additionalProperties": true
    }
  }
}
