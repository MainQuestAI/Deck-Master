{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:deck-master:sc1:deck_context_pack.v2",
  "title": "deck_context_pack.v2",
  "description": "Version-bound host extraction contract. Structural validation does not replace actual source reading.",
  "x-spec-status": "runtime",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "deck_context_pack.v2"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "run_mode": {
      "type": "string",
      "enum": [
        "production",
        "benchmark",
        "fixture",
        "dev"
      ]
    },
    "based_on": {
      "type": "object",
      "properties": {
        "input_fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "input_refs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "ref",
              "sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        }
      },
      "required": [
        "input_fingerprint",
        "input_refs"
      ],
      "additionalProperties": false
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "source_type": {
            "type": "string",
            "enum": [
              "text",
              "markdown",
              "pdf",
              "docx",
              "xlsx",
              "pptx",
              "image",
              "web",
              "host_export"
            ]
          },
          "origin_type": {
            "type": "string",
            "enum": [
              "authorized_local",
              "authorized_web",
              "host_export"
            ]
          },
          "origin_ref": {
            "type": "string",
            "minLength": 1
          },
          "capture_supersedes_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Explicit upgrade of the same research URL from its current partial excerpt to a complete observed capture; not a local source version override."
          },
          "file_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "extraction": {
            "type": "object",
            "properties": {
              "method": {
                "type": "string",
                "minLength": 1
              },
              "tool_ref": {
                "type": "string",
                "minLength": 1
              },
              "read_units": {
                "type": "integer",
                "minimum": 0
              },
              "total_units": {
                "type": "integer",
                "minimum": 0
              },
              "unread_regions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0
              },
              "status": {
                "type": "string",
                "enum": [
                  "complete",
                  "partial",
                  "failed"
                ]
              },
              "snapshot_ref": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "method",
              "tool_ref",
              "read_units",
              "total_units",
              "unread_regions",
              "status",
              "snapshot_ref"
            ],
            "additionalProperties": false
          },
          "evidence_candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "evidence_id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "source_position": {
                  "type": "object",
                  "properties": {
                    "unit_type": {
                      "type": "string",
                      "enum": [
                        "line",
                        "page",
                        "slide",
                        "paragraph",
                        "character",
                        "region"
                      ]
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 0
                    }
                  },
                  "required": [
                    "unit_type",
                    "start",
                    "end",
                    "detail"
                  ],
                  "additionalProperties": false
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                },
                "quote_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "publication_status": {
                  "type": "string",
                  "enum": [
                    "safe_to_use",
                    "internal_only",
                    "needs_redaction",
                    "unknown"
                  ]
                },
                "sensitivity": {
                  "type": "string",
                  "enum": [
                    "normal",
                    "sensitive",
                    "high"
                  ]
                },
                "claim_kind": {
                  "type": "string",
                  "enum": [
                    "user_reported_fact",
                    "external_fact",
                    "constraint"
                  ]
                },
                "period": {
                  "type": "string",
                  "minLength": 0
                },
                "unit": {
                  "type": "string",
                  "minLength": 0
                },
                "applicability": {
                  "type": "string",
                  "minLength": 1
                },
                "review_status": {
                  "type": "string",
                  "enum": [
                    "unreviewed",
                    "supported",
                    "contradicted",
                    "insufficient"
                  ]
                },
                "review_ref": {
                  "type": "string",
                  "minLength": 0
                }
              },
              "required": [
                "evidence_id",
                "statement",
                "source_position",
                "quote",
                "quote_sha256",
                "publication_status",
                "sensitivity",
                "claim_kind",
                "period",
                "unit",
                "applicability",
                "review_status",
                "review_ref"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "review_status": {
                        "const": "supported"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "review_ref": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              ]
            },
            "minItems": 0
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "sensitive",
              "high"
            ]
          },
          "publication_status": {
            "type": "string",
            "enum": [
              "safe_to_use",
              "internal_only",
              "needs_redaction",
              "unknown"
            ]
          }
        },
        "required": [
          "source_id",
          "title",
          "source_type",
          "origin_type",
          "origin_ref",
          "file_sha256",
          "summary",
          "extraction",
          "evidence_candidates",
          "sensitivity",
          "publication_status"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "global_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "conflict_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 2
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 0
          },
          "decision_ref": {
            "type": "string",
            "minLength": 0
          }
        },
        "required": [
          "conflict_id",
          "evidence_refs",
          "description",
          "status",
          "resolution",
          "decision_ref"
        ],
        "additionalProperties": false
      },
      "minItems": 0
    },
    "research_meta": {
      "type": "object",
      "properties": {
        "task_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "status": {
          "type": "string",
          "enum": [
            "not_requested",
            "executed",
            "inconclusive",
            "capability_unavailable"
          ]
        },
        "execution_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "open_questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "task_id",
        "status",
        "execution_refs",
        "summary",
        "open_questions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "run_mode",
    "based_on",
    "sources",
    "global_constraints",
    "conflicts",
    "research_meta"
  ],
  "additionalProperties": false
}
