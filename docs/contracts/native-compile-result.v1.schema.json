{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/spec/sc1.1/native-compile-result.v1.schema.json",
  "title": "native-compile-result.v1",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "build_revision",
    "engine_id",
    "engine_version",
    "subset_version",
    "input_fingerprint",
    "status",
    "pages",
    "warnings",
    "errors",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "const": "deck_native_compile_result.v1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "build_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "engine_id": {
      "const": "deck_native"
    },
    "engine_version": {
      "type": "string",
      "minLength": 1
    },
    "subset_version": {
      "type": "string",
      "minLength": 1
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "compiled",
        "failed"
      ]
    },
    "outputs": {
      "type": "object",
      "required": [
        "deck_pptx",
        "object_trace"
      ],
      "properties": {
        "deck_pptx": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:)[A-Za-z0-9_./-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        },
        "object_trace": {
          "type": "object",
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?![A-Za-z]:)[A-Za-z0-9_./-]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "page_id",
          "order",
          "svg_sha256",
          "text_objects",
          "shape_objects",
          "image_objects"
        ],
        "properties": {
          "page_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "svg_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "text_objects": {
            "type": "integer",
            "minimum": 0
          },
          "shape_objects": {
            "type": "integer",
            "minimum": 0
          },
          "image_objects": {
            "type": "integer",
            "minimum": 0
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "message",
          "page_id",
          "element_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "page_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "element_id": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "minItems": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "compiled"
          }
        }
      },
      "then": {
        "required": [
          "outputs"
        ],
        "properties": {
          "pages": {
            "minItems": 1
          },
          "errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "failed"
          }
        }
      },
      "then": {
        "properties": {
          "errors": {
            "minItems": 1
          }
        },
        "not": {
          "required": [
            "outputs"
          ]
        }
      }
    }
  ]
}
