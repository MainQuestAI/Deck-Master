{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/content-lock.v2.schema.json",
  "title": "Deck Content Lock v2",
  "type": "object",
  "required": ["schema_version", "run_id", "page_id", "page_package_ref", "page_package_sha256", "source_fingerprint", "customer_visible", "evidence_bindings", "enrichment", "required_component_ids", "required_text_refs", "density_target", "target_language", "content_lock_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_content_lock.v2"},
    "run_id": {"type": "string", "minLength": 1},
    "page_id": {"type": "string", "minLength": 1},
    "page_package_ref": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
    "page_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "customer_visible": {"type": "object"},
    "speaker_notes": {"type": "string"},
    "asset_bindings": {"type": "array", "items": {"type": "object"}},
    "evidence_bindings": {"type": "array", "items": {"oneOf": [{"type": "string"}, {"type": "object"}]}},
    "enrichment": {"type": "object"},
    "required_component_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "required_text_refs": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "density_target": {"type": "object"},
    "target_language": {"type": "string", "minLength": 1},
    "effective_language": {"type": "string"},
    "lineage": {"type": "object"},
    "content_lock_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"}
  },
  "additionalProperties": true
}
