{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/pptx-readback.v2.schema.json",
  "title": "PPTX Readback v2",
  "type": "object",
  "required": ["schema_version", "run_id", "pptx_sha256", "slide_count", "expected_slide_count", "speaker_notes_count", "expected_speaker_notes_count", "pages", "text_readback", "geometry", "trace_coverage", "drawingml_paint", "shape_readback", "group_readback", "media_relationships", "visual_parity", "local_visual_parity", "editable_object_count", "image_shape_count", "expected_image_count", "status", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_pptx_readback.v2"},
    "run_id": {"type": "string"},
    "pptx_sha256": {"type": "string"},
    "slide_count": {"type": "integer"},
    "expected_slide_count": {"type": "integer"},
    "speaker_notes_count": {"type": "integer"},
    "expected_speaker_notes_count": {"type": "integer"},
    "pages": {"type": "array", "items": {"type": "object"}},
    "text_readback": {"type": "object"},
    "geometry": {"type": "object"},
    "trace_coverage": {"type": "object"},
    "drawingml_paint": {"type": "object", "required": ["gradient_count", "gradient_stop_count", "effect_count", "gradient_stop_alpha_values", "status"], "properties": {"gradient_count": {"type": "integer", "minimum": 0}, "gradient_stop_count": {"type": "integer", "minimum": 0}, "effect_count": {"type": "integer", "minimum": 0}, "gradient_stop_alpha_values": {"type": "array", "items": {"type": "integer", "minimum": 0, "maximum": 100000}}, "status": {"enum": ["pass", "failed"]}}, "additionalProperties": true},
    "shape_readback": {"type": "object"},
    "group_readback": {"type": "object"},
    "media_relationships": {"type": "object"},
    "visual_parity": {"type": "object"},
    "local_visual_parity": {"type": "object"},
    "editable_object_count": {"type": "integer"},
    "image_shape_count": {"type": "integer"},
    "expected_image_count": {"type": "integer"},
    "status": {"enum": ["pass", "failed"]},
    "created_at": {"type": "string"}
  },
  "additionalProperties": false
}
