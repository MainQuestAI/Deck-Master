{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Disposable public Narrative MBB compatibility projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "authority",
    "source_narrative_ref",
    "source_narrative_sha256",
    "source_revision",
    "input_fingerprint",
    "projection_sha256",
    "candidates",
    "recommended_candidate_id",
    "selected_candidate_id",
    "selection_decision_ref",
    "narrative_pages",
    "package_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "deck_mbb_projection.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "authority": {
      "const": "public_narrative"
    },
    "source_narrative_ref": {
      "const": "narrative_plan.json"
    },
    "source_narrative_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_revision": {
      "type": "string"
    },
    "input_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "projection_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "recommended_candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selected_candidate_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "selection_decision_ref": {
      "type": "string"
    },
    "narrative_pages": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "package_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "ref",
          "sha256"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^page_packages/[^/]+\\.json$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
