{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/high-density-status.v1.schema.json",
  "title": "High Density Build Status v1",
  "type": "object",
  "required": ["schema_version", "run_id", "builder_profile", "status", "current_stage", "next_action", "updated_at"],
  "properties": {
    "schema_version": {"const": "deck_high_density_status.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "builder_profile": {"const": "high_density"},
    "status": {"enum": ["prepared", "building", "awaiting_agent_build", "completed", "blocked", "failed", "stale"]},
    "current_page_id": {"type": "string"},
    "current_stage": {"enum": ["content_lock", "blueprint", "page_scene", "svg", "visual_review", "pptx", "readback", "handback", ""]},
    "next_action": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "agent_imagegen", "agent_scene_redraw", "agent_visual_review", "retry", "blocked"]},
        "page_id": {"type": "string"},
        "stage": {"type": "string"},
        "input_ref": {"type": "string"},
        "output_ref": {"type": "string"},
        "resume_command": {"type": "string"},
        "reason": {"type": "string"}
      },
      "additionalProperties": false
    },
    "error": {"type": "object"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "awaiting_agent_build"}}},
      "then": {
        "required": ["current_page_id"],
        "properties": {
          "next_action": {
            "required": ["page_id", "stage", "input_ref", "output_ref", "resume_command", "reason"],
            "properties": {"kind": {"enum": ["agent_imagegen", "agent_scene_redraw", "agent_visual_review", "retry"]}}
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
