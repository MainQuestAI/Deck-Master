{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/high-density-manifest.v1.schema.json",
  "title": "High Density Build Lineage Manifest v1",
  "type": "object",
  "required": ["schema_version", "run_id", "builder_profile", "source_fingerprint", "status", "pages", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_high_density_manifest.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "builder_profile": {"const": "high_density"},
    "source_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"enum": ["prepared", "building", "completed", "blocked", "failed", "stale"]},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "created_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["page_id", "order", "status", "content_lock", "blueprint", "page_scene", "svg", "preview", "visual_review", "pptx_trace", "readback_report", "blockers"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "status": {"enum": ["pending", "content_ready", "blueprint_ready", "page_scene_ready", "svg_ready", "visual_review_passed", "pptx_ready", "readback_passed", "completed", "blocked", "stale", "failed"]},
        "content_lock": {"$ref": "#/$defs/ref"},
        "blueprint": {"$ref": "#/$defs/ref"},
        "page_scene": {"$ref": "#/$defs/ref"},
        "svg": {"$ref": "#/$defs/ref"},
        "preview": {"$ref": "#/$defs/ref"},
        "visual_review": {"$ref": "#/$defs/ref"},
        "pptx_trace": {"$ref": "#/$defs/ref"},
        "readback_report": {"$ref": "#/$defs/ref"},
        "blockers": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
