{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deck-master.local/contracts/mbb-plan.v1.schema.json",
  "title": "MBB Plan v1",
  "type": "object",
  "required": ["schema_version", "run_id", "page_count", "evidence_ledger", "storyline_candidates", "selection", "storyline_audit", "scr", "pages", "blocked_pages", "mbb_plan_sha256", "created_at"],
  "properties": {
    "schema_version": {"const": "deck_mbb_plan.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "evidence_ledger": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
    "storyline_candidates": {"type": "array", "minItems": 2, "maxItems": 3, "items": {"$ref": "#/$defs/storyline"}},
    "selection": {"$ref": "#/$defs/selection"},
    "storyline_audit": {"$ref": "#/$defs/storylineAudit"},
    "scr": {"oneOf": [{"$ref": "#/$defs/scr"}, {"type": "null"}]},
    "pages": {"type": "array", "items": {"$ref": "#/$defs/pagePlan"}},
    "blocked_pages": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["page_id", "reason"], "properties": {"page_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}}},
    "mbb_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "created_at": {"type": "string", "minLength": 1},
    "updated_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "$defs": {
    "evidence": {
      "type": "object",
      "required": ["evidence_id", "source_ref", "source_position", "period", "unit", "confidence", "conflicts", "caveat", "source_context", "meaning", "implication", "recommended_visual"],
      "properties": {
        "evidence_id": {"type": "string", "minLength": 1},
        "source_ref": {"type": "string", "minLength": 1},
        "source_position": {"type": "string"},
        "period": {"type": "string"},
        "unit": {"type": "string"},
        "confidence": {"type": "string", "minLength": 1},
        "conflicts": {"type": "array", "items": {"type": "string"}},
        "caveat": {"type": "string"},
        "source_context": {"type": "string", "minLength": 1},
        "meaning": {"type": "string"},
        "implication": {"type": "string"},
        "recommended_visual": {"type": "string"}
      },
      "additionalProperties": false
    },
    "treeBranch": {
      "type": "object",
      "required": ["branch_id", "question", "hypothesis", "evidence_refs"],
      "properties": {
        "branch_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "hypothesis": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "storyline": {
      "type": "object",
      "required": ["storyline_id", "management_conclusion", "audience", "issue_hypothesis_tree", "evidence_refs", "caveat", "visual_potential", "not_recommended_because", "page_handoff", "density_target", "language", "evidence_assessment", "chart_plan", "claim_bindings"],
      "properties": {
        "storyline_id": {"type": "string", "minLength": 1},
        "management_conclusion": {"type": "string", "minLength": 1},
        "audience": {"type": "string", "minLength": 1},
        "issue_hypothesis_tree": {"type": "object", "required": ["root", "branches"], "properties": {"root": {"type": "string", "minLength": 1}, "branches": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/treeBranch"}}}, "additionalProperties": false},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1}},
        "caveat": {"type": "string", "minLength": 1},
        "visual_potential": {"type": "string", "minLength": 1},
        "not_recommended_because": {"type": "string", "minLength": 1},
        "page_handoff": {"type": "string", "minLength": 1},
        "density_target": {"type": "object", "required": ["band", "information_regions"], "properties": {"band": {"enum": ["low", "medium", "high"]}, "information_regions": {"type": "integer", "minimum": 3}}, "additionalProperties": false},
        "language": {"type": "string", "minLength": 1},
        "evidence_assessment": {"$ref": "#/$defs/evidenceAssessment"},
        "chart_plan": {"$ref": "#/$defs/chartPlan"},
        "claim_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claimBinding"}}
      },
      "additionalProperties": false
    },
    "selection": {
      "type": "object",
      "required": ["status", "recommended_storyline_id", "selected_storyline_id", "selected_by", "selected_at", "sealed_at"],
      "properties": {
        "status": {"enum": ["pending_user_decision", "selected_pending_enrichment", "approved"]},
        "recommended_storyline_id": {"type": "string", "minLength": 1},
        "selected_storyline_id": {"type": ["string", "null"]},
        "selected_by": {"type": ["string", "null"]},
        "selected_at": {"type": ["string", "null"]},
        "sealed_at": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "storylineAudit": {
      "type": "object",
      "required": ["source", "status", "candidate_count", "recommendation_id", "selected_id", "content_specific", "notes"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "status": {"enum": ["pending_user_decision", "selected_pending_enrichment", "approved"]},
        "candidate_count": {"type": "integer", "minimum": 2, "maximum": 3},
        "recommendation_id": {"type": "string", "minLength": 1},
        "selected_id": {"type": ["string", "null"]},
        "content_specific": {"const": true},
        "notes": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "scr": {
      "type": "object",
      "required": ["situation", "complication", "resolution", "evidence_refs", "decision_implication", "evidence_assessment", "claim_bindings"],
      "properties": {
        "situation": {"type": "string", "minLength": 1},
        "complication": {"type": "string", "minLength": 1},
        "resolution": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "decision_implication": {"type": "string", "minLength": 1},
        "evidence_assessment": {"$ref": "#/$defs/evidenceAssessment"},
        "claim_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claimBinding"}}
      },
      "additionalProperties": false
    },
    "component": {
      "type": "object",
      "required": ["component_id", "kind", "priority", "region"],
      "properties": {
        "component_id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "region": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "textRef": {
      "type": "object",
      "required": ["ref", "priority", "required"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "priority": {"enum": ["P0", "P1", "P2"]},
        "required": {"const": true},
        "structural": {"type": "boolean"},
        "value": {"type": "string"}
      },
      "additionalProperties": false
    },
    "derivedClaim": {
      "type": "object",
      "required": ["claim_id", "origin", "evidence_refs", "derivation_note", "factual_value_added"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "origin": {"enum": ["source", "derived", "structural_label"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "derivation_note": {"type": "string", "minLength": 1},
        "factual_value_added": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "claimBinding": {
      "type": "object",
      "required": ["target", "text_sha256", "origin", "evidence_refs", "evidence_spans", "derivation_note"],
      "properties": {
        "target": {"type": "string", "minLength": 1},
        "text_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "origin": {"enum": ["source", "derived", "structural_label"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_spans": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_ref", "quote", "quote_sha256"],
            "properties": {
              "evidence_ref": {"type": "string", "minLength": 1},
              "quote": {"type": "string", "minLength": 1},
              "quote_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "derivation_note": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evidenceAssessment": {
      "type": "object",
      "required": ["strongest_evidence_refs", "evidence_strength", "contrary_evidence_refs", "missing_evidence", "conflicts", "synthesis"],
      "properties": {
        "strongest_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence_strength": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "contrary_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "missing_evidence": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conflicts": {"type": "array", "items": {"type": "object", "required": ["evidence_id", "conflicts"], "properties": {"evidence_id": {"type": "string", "minLength": 1}, "conflicts": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false}},
        "synthesis": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "chartPlan": {
      "type": "object",
      "required": ["visual_type", "metric_refs", "comparison_axis", "annotations", "source_refs"],
      "properties": {
        "visual_type": {"type": "string", "minLength": 1},
        "metric_refs": {"type": "array", "items": {"type": "string"}},
        "comparison_axis": {"type": "string", "minLength": 1},
        "annotations": {"type": "array", "items": {"type": "string"}},
        "source_refs": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "storylineContext": {
      "type": "object",
      "required": ["storyline_id", "management_conclusion", "visual_potential", "page_handoff", "caveat", "evidence_refs"],
      "properties": {
        "storyline_id": {"type": "string", "minLength": 1},
        "management_conclusion": {"type": "string"},
        "visual_potential": {"type": "string", "minLength": 1},
        "page_handoff": {"type": "string"},
        "caveat": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "pagePlan": {
      "type": "object",
      "required": ["page_id", "order", "page_package_sha256", "storyline_id", "storyline_context", "role", "conclusion", "supporting_arguments", "detailed_argument", "evidence_refs", "caveat", "so_what", "business_implication", "handoff", "evidence_hierarchy", "evidence_assessment", "chart_plan", "material_pool", "density_target", "components", "required_text_refs", "derived_claims", "claim_bindings", "status", "page_plan_sha256"],
      "properties": {
        "page_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1},
        "page_package_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "storyline_id": {"type": "string", "minLength": 1},
        "storyline_context": {"$ref": "#/$defs/storylineContext"},
        "role": {"type": "string", "minLength": 1},
        "conclusion": {"type": "string"},
        "supporting_arguments": {"type": "array", "items": {"type": "string"}},
        "detailed_argument": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}},
        "caveat": {"type": "array", "items": {"type": "string"}},
        "so_what": {"type": "string"},
        "business_implication": {"type": "string"},
        "handoff": {"type": "string"},
        "evidence_hierarchy": {"type": "object", "required": ["primary", "supporting", "caveat"], "properties": {"primary": {"type": "array", "items": {"type": "string"}}, "supporting": {"type": "array", "items": {"type": "string"}}, "caveat": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": false},
        "evidence_assessment": {"$ref": "#/$defs/evidenceAssessment"},
        "chart_plan": {"$ref": "#/$defs/chartPlan"},
        "material_pool": {
          "type": "object",
          "required": ["customer_visible", "evidence_refs", "recommended_visual", "numeric_values", "storyline_id", "storyline_visual_potential", "storyline_page_handoff", "storyline_caveat", "comparisons", "rankings", "changes", "funnel_steps", "matrix_axes", "annotations", "legend", "microcharts", "area_count", "low_density_risk"],
          "properties": {
            "customer_visible": {"type": "object"},
            "evidence_refs": {"type": "array", "items": {"type": "string"}},
            "recommended_visual": {"type": "string", "minLength": 1},
            "numeric_values": {"type": "array", "items": {"type": "string"}},
            "storyline_id": {"type": "string", "minLength": 1},
            "storyline_visual_potential": {"type": "string", "minLength": 1},
            "storyline_page_handoff": {"type": "string"},
            "storyline_caveat": {"type": "string"},
            "comparisons": {"type": "array", "items": {"type": "string"}},
            "rankings": {"type": "array", "items": {"type": "string"}},
            "changes": {"type": "array", "items": {"type": "string"}},
            "funnel_steps": {"type": "array", "items": {"type": "string"}},
            "matrix_axes": {"type": "array", "items": {"type": "string"}},
            "annotations": {"type": "array", "items": {"type": "string"}},
            "legend": {"type": "array", "items": {"type": "string"}},
            "microcharts": {"type": "array", "items": {"type": "string"}},
            "area_count": {"type": "integer", "minimum": 3},
            "low_density_risk": {"enum": ["high", "managed"]}
          },
          "additionalProperties": false
        },
        "density_target": {"type": "object", "required": ["score", "band", "information_regions"], "properties": {"score": {"type": "number", "minimum": 0}, "band": {"enum": ["low", "medium", "high"]}, "information_regions": {"type": "integer", "minimum": 3}}, "additionalProperties": false},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
        "required_text_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/textRef"}},
        "derived_claims": {"type": "array", "items": {"$ref": "#/$defs/derivedClaim"}},
        "claim_bindings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claimBinding"}},
        "status": {"const": "ready"},
        "page_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "created_at": {"type": "string"},
        "updated_at": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {"role": {"enum": ["cover", "section", "section_divider", "divider", "toc", "agenda", "visual", "visual_divider", "image", "image_page"]}},
            "required": ["role"]
          },
          "then": {
            "properties": {
              "conclusion": {"const": ""},
              "supporting_arguments": {"maxItems": 0},
              "detailed_argument": {"const": ""},
              "evidence_refs": {"items": {"type": "string", "minLength": 1}},
              "caveat": {"maxItems": 0},
              "so_what": {"const": ""},
              "business_implication": {"const": ""},
              "handoff": {"const": ""},
              "storyline_context": {"properties": {"management_conclusion": {"const": ""}, "visual_potential": {"const": "structural layout"}, "page_handoff": {"const": ""}, "caveat": {"const": ""}, "evidence_refs": {"maxItems": 0}}},
              "evidence_hierarchy": {"properties": {"primary": {"items": {"type": "string", "minLength": 1}}, "supporting": {"items": {"type": "string", "minLength": 1}}, "caveat": {"maxItems": 0}}},
              "chart_plan": {"properties": {"metric_refs": {"maxItems": 0}, "annotations": {"maxItems": 0}, "source_refs": {"maxItems": 0}}},
              "material_pool": {"properties": {"evidence_refs": {"maxItems": 0}, "numeric_values": {"maxItems": 0}, "comparisons": {"maxItems": 0}, "changes": {"maxItems": 0}, "annotations": {"maxItems": 0}, "storyline_page_handoff": {"const": ""}, "storyline_caveat": {"const": ""}}}
            }
          }
        },
        {
          "if": {
            "properties": {"role": {"not": {"enum": ["cover", "section", "section_divider", "divider", "toc", "agenda", "visual", "visual_divider", "image", "image_page"]}}},
            "required": ["role"]
          },
          "then": {
            "properties": {
              "conclusion": {"minLength": 1},
              "supporting_arguments": {"minItems": 1, "items": {"minLength": 1}},
              "detailed_argument": {"minLength": 1},
              "evidence_refs": {"minItems": 1, "items": {"minLength": 1}},
              "caveat": {"minItems": 1, "items": {"minLength": 1}},
              "so_what": {"minLength": 1},
              "business_implication": {"minLength": 1},
              "handoff": {"minLength": 1},
              "storyline_context": {"properties": {"management_conclusion": {"minLength": 1}, "visual_potential": {"minLength": 1}, "page_handoff": {"minLength": 1}, "caveat": {"minLength": 1}, "evidence_refs": {"minItems": 1, "items": {"minLength": 1}}}},
              "evidence_hierarchy": {"properties": {"primary": {"minItems": 1}}},
              "chart_plan": {"properties": {"source_refs": {"minItems": 1, "items": {"minLength": 1}}}},
              "material_pool": {"properties": {"evidence_refs": {"minItems": 1, "items": {"minLength": 1}}, "storyline_page_handoff": {"minLength": 1}, "storyline_caveat": {"minLength": 1}}}
            }
          }
        }
      ]
    }
  }
}
